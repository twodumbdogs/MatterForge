@page "{id:guid}"
@model MatterForge.Pages.Submissions.ConvertModel
@{
    ViewData["Title"] = "Create Client/Matter";
}

@if (Model.Submission is null)
{
    <div class="alert alert-warning">That submission could not be found.</div>
}
else if (Model.Submission.ClientId.HasValue || Model.Submission.MatterId.HasValue)
{
    <div class="alert alert-info">
        This submission is already linked to a client or matter.
        <a asp-page="./Details" asp-route-id="@Model.Submission.Id">Return to submission</a>
    </div>
}
else if (!Model.MatterLimit.CanCreate)
{
    <div class="alert alert-warning">
        @Model.MatterLimit.Message
        <a asp-page="/Billing/Index">View plans</a>
    </div>
}
else if (!Model.CanConvert)
{
    <div class="alert alert-warning">
        This submission must be approved before client and matter records can be created.
        <a asp-page="./Details" asp-route-id="@Model.Submission.Id">Return to submission</a>
    </div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Workflow action</p>
            <h1>Create Client/Matter</h1>
            <p class="text-muted">Review the prefilled values before creating operational records.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Submission.Id">Back</a>
    </div>

    <form method="post" class="mf-panel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        @if (Model.HasExistingClientMatches)
        {
            <div class="alert alert-info mb-4">
                <div class="form-check">
                    <input asp-for="Input.UseExistingClient" class="form-check-input" />
                    <label asp-for="Input.UseExistingClient" class="form-check-label"></label>
                </div>
                <span asp-validation-for="Input.UseExistingClient" class="text-danger d-block mt-1"></span>

                <div class="mt-3">
                    <label asp-for="Input.ExistingClientId" class="form-label"></label>
                    <select asp-for="Input.ExistingClientId" asp-items="Model.ExistingClientOptions" class="form-select">
                        <option value="">Choose an existing client...</option>
                    </select>
                    <span asp-validation-for="Input.ExistingClientId" class="text-danger"></span>
                </div>

                <div class="mt-2 text-muted small">
                    @Model.ExistingClientHint
                    When reuse is on, the client fields below are left alone and only a new matter is created.
                </div>
            </div>
        }

        <h2 class="h5">Client</h2>
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <label asp-for="Input.ClientName" class="form-label"></label>
                <input asp-for="Input.ClientName" class="form-control" />
                <span asp-validation-for="Input.ClientName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.ClientStatus" class="form-label"></label>
                <select asp-for="Input.ClientStatus" class="form-select">
                    <option>Active</option>
                    <option>Prospective</option>
                    <option>Inactive</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.PrimaryContact" class="form-label"></label>
                <input asp-for="Input.PrimaryContact" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Phone" class="form-label"></label>
                <input asp-for="Input.Phone" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Input.ClientNotes" class="form-label"></label>
                <textarea asp-for="Input.ClientNotes" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <h2 class="h5">Matter</h2>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Input.MatterName" class="form-label"></label>
                <input asp-for="Input.MatterName" class="form-control" />
                <span asp-validation-for="Input.MatterName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.MatterStatus" class="form-label"></label>
                <select asp-for="Input.MatterStatus" class="form-select">
                    <option>Open</option>
                    <option>Pending</option>
                    <option>On Hold</option>
                    <option>Closed</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.PracticeArea" class="form-label"></label>
                <input asp-for="Input.PracticeArea" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.OpenedDate" class="form-label"></label>
                <input asp-for="Input.OpenedDate" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.ResponsibleUserId" class="form-label"></label>
                <select asp-for="Input.ResponsibleUserId" asp-items="Model.UserOptions" class="form-select">
                    <option value="">Unassigned</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Input.MatterNotes" class="form-label"></label>
                <textarea asp-for="Input.MatterNotes" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Create and link records</button>
            <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Submission.Id">Cancel</a>
        </div>
    </form>

    <div class="mf-panel mt-3">
        <h2 class="h5">Source Answers</h2>
        <dl class="row mb-0">
            @foreach (var answer in Model.SourceAnswers)
            {
                <dt class="col-sm-4">@answer.Label</dt>
                <dd class="col-sm-8">@answer.Value</dd>
            }
        </dl>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
