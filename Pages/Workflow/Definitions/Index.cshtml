@page
@model CMIForge.Pages.Workflow.Definitions.IndexModel
@{
    ViewData["Title"] = "Workflow Definitions";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Workflow builder</p>
        <h1>Workflow Definitions</h1>
    </div>
    <div class="mf-hero-actions">
        <a class="btn btn-outline-secondary" asp-page="/Workflow/Notifications/Index">Notification templates</a>
        <a class="btn btn-primary" asp-page="./Create">Create workflow</a>
    </div>
</div>

<div class="mf-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @if (Model.Workflows.Count == 0)
    {
        <p class="text-muted mb-0">No workflows have been created yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Key</th>
                        <th>Default form scope</th>
                        <th>Steps</th>
                        <th>Status</th>
                        <th>Publish state</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var workflow in Model.Workflows)
                    {
                        <tr>
                            <td>
                                <strong>@workflow.Name</strong>
                                <small class="d-block text-muted">@workflow.Description</small>
                            </td>
                            <td><code>@workflow.Key</code></td>
                            <td>@(workflow.FormDefinition?.Name ?? "Global fallback")</td>
                            <td>@workflow.Steps.Count</td>
                            <td>
                                <span class="badge @(workflow.IsActive ? "text-bg-success" : "text-bg-secondary")">@(workflow.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td>
                                <span class="badge @(workflow.IsPublished ? "text-bg-success" : "text-bg-warning")">@(workflow.IsPublished ? "Published / live" : "Saved draft")</span>
                                @if (workflow.PublishedAt.HasValue)
                                {
                                    <small class="d-block text-muted">@UserDates.Format(workflow.PublishedAt.Value, "g")</small>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Options
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-page="./Edit" asp-route-id="@workflow.Id">Edit</a></li>
                                        <li>
                                            <form method="post" asp-page-handler="Copy" asp-route-id="@workflow.Id">
                                                <button class="dropdown-item" type="submit">Copy</button>
                                            </form>
                                        </li>
                                        @if (Model.CanManageFormWorkflowDefinitions)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@workflow.Id" onsubmit="return confirm('Retire this workflow? Historical workflow records stay available, but it will no longer be used for new submissions.');">
                                                    <button class="dropdown-item text-danger" type="submit">Delete</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
