@page
@model CMIForge.Pages.Workflow.Definitions.CreateModel
@{
    ViewData["Title"] = "Create Workflow";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Workflow builder</p>
        <h1>Create Workflow</h1>
        <p class="text-muted mb-0">Save a draft while you build. Publish when it is ready to become live.</p>
    </div>
</div>

<form method="post" class="mf-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" placeholder="Standard Intake Review" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Key" class="form-label"></label>
            <input asp-for="Input.Key" class="form-control" placeholder="standard-intake-review" />
            <span asp-validation-for="Input.Key" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.FormDefinitionId" class="form-label"></label>
            <select asp-for="Input.FormDefinitionId" asp-items="Model.FormOptions" class="form-select">
                <option value="">Global fallback</option>
            </select>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">Enabled when published</label>
            </div>
        </div>
    </div>

    <hr />

    <div class="mf-workflow-builder-heading">
        <div>
            <h2 class="h5 mb-1">Steps</h2>
            <p class="text-muted mb-0">New submissions receive the first matching task from the workflow attached to their form version.</p>
        </div>
    </div>

    <div class="mf-workflow-step-list" data-workflow-step-list>
        @for (var i = 0; i < Model.Input.Steps.Count; i++)
        {
            <section class="mf-workflow-step-card" data-workflow-step-card>
                <div class="mf-workflow-step-header">
                    <div class="mf-workflow-step-controls">
                        <button class="btn btn-outline-secondary btn-sm" type="button" data-move-workflow-step="up" aria-label="Move step up" title="Move step up">&uarr;</button>
                        <button class="btn btn-outline-secondary btn-sm" type="button" data-move-workflow-step="down" aria-label="Move step down" title="Move step down">&darr;</button>
                    </div>
                    <div class="mf-workflow-step-number">
                        <label asp-for="Input.Steps[i].StepNumber" class="form-label">Order</label>
                        <input class="form-control" asp-for="Input.Steps[i].StepNumber" />
                    </div>
                    <div>
                        <label asp-for="Input.Steps[i].Name" class="form-label">Step name</label>
                        <input class="form-control" asp-for="Input.Steps[i].Name" placeholder="Review" />
                    </div>
                    <div>
                        <label asp-for="Input.Steps[i].StepType" class="form-label">Type</label>
                        <select class="form-select" asp-for="Input.Steps[i].StepType" asp-items="Model.StepTypeOptions" data-workflow-step-type></select>
                    </div>
                </div>

                <div class="mf-workflow-step-grid">
                    <div class="mf-workflow-step-section" data-workflow-approval-section>
                        <div class="mf-section-label">Assignment</div>
                        <div class="mf-form-grid two">
                            <div>
                                <label asp-for="Input.Steps[i].AssignedUserId" class="form-label">User</label>
                                <select class="form-select" asp-for="Input.Steps[i].AssignedUserId" asp-items="Model.UserOptions">
                                    <option value="">Unassigned</option>
                                </select>
                            </div>
                            <div>
                                <label asp-for="Input.Steps[i].AssignedTeamId" class="form-label">Team</label>
                                <select class="form-select" asp-for="Input.Steps[i].AssignedTeamId" asp-items="Model.TeamOptions">
                                    <option value="">No team</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mf-workflow-step-section" data-workflow-notification-section>
                        <div class="mf-section-label">Notification</div>
                        <input type="hidden" asp-for="Input.Steps[i].NotificationSubject" />
                        <input type="hidden" asp-for="Input.Steps[i].NotificationBody" />
                        <div class="mf-form-grid two">
                            <div>
                                <label asp-for="Input.Steps[i].NotificationTemplateId" class="form-label">Template</label>
                                <select class="form-select" asp-for="Input.Steps[i].NotificationTemplateId" asp-items="Model.NotificationTemplateOptions">
                                    <option value="">Default workflow message</option>
                                </select>
                            </div>
                            <div>
                                <label asp-for="Input.Steps[i].NotificationRecipientTokens" class="form-label">Recipients</label>
                                <select class="form-select" asp-for="Input.Steps[i].NotificationRecipientTokens" asp-items="Model.NotificationRecipientOptions" multiple size="4"></select>
                            </div>
                        </div>
                    </div>

                    <div class="mf-workflow-step-section" data-workflow-routing-section>
                        <div class="mf-section-label">Approval outcome</div>
                        <div class="mf-form-grid three">
                            <div>
                                <label asp-for="Input.Steps[i].ApprovalLabel" class="form-label">Primary label</label>
                                <input class="form-control" asp-for="Input.Steps[i].ApprovalLabel" />
                            </div>
                            <div>
                                <label asp-for="Input.Steps[i].CompletionSubmissionStatus" class="form-label">Status</label>
                                <select class="form-select" asp-for="Input.Steps[i].CompletionSubmissionStatus" asp-items="Model.CompletionStatusOptions"></select>
                            </div>
                            <div>
                                <label asp-for="Input.Steps[i].Outcomes" class="form-label">Outcomes</label>
                                <input class="form-control" asp-for="Input.Steps[i].Outcomes" placeholder="Approve|Advance|In Review; Return|Return|Returned" title="@CMIForge.Services.WorkflowOutcomeParser.DesignerHelpText" />
                            </div>
                        </div>
                    </div>

                    <div class="mf-workflow-step-section">
                        <div class="mf-section-label">Routing</div>
                        <div class="mf-form-grid four">
                            <div>
                                <label asp-for="Input.Steps[i].ConditionFieldKey" class="form-label">Run when</label>
                                <input class="form-control" asp-for="Input.Steps[i].ConditionFieldKey" placeholder="cdd" />
                            </div>
                            <div>
                                <label asp-for="Input.Steps[i].ConditionOperator" class="form-label">Operator</label>
                                <select class="form-select" asp-for="Input.Steps[i].ConditionOperator" asp-items="Model.ConditionOperatorOptions"></select>
                            </div>
                            <div>
                                <label asp-for="Input.Steps[i].ConditionValue" class="form-label">Value</label>
                                <input class="form-control" asp-for="Input.Steps[i].ConditionValue" placeholder="Yes" />
                            </div>
                            <div>
                                <label asp-for="Input.Steps[i].Instructions" class="form-label">Instructions</label>
                                <input class="form-control" asp-for="Input.Steps[i].Instructions" />
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit" name="WorkflowAction" value="draft">Save draft</button>
        <button class="btn btn-primary" type="submit" name="WorkflowAction" value="publish">Publish workflow</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/workflow-designer.js" asp-append-version="true"></script>
}
