@page "{id:guid}"
@model CMIForge.Pages.Time.EditModel
@{
    ViewData["Title"] = Model.Entry is null ? "Edit Time" : $"Edit Time {Model.Entry.TimeEntryNumber:D8}";
}

@if (Model.Entry is null)
{
    <div class="alert alert-warning">That time entry could not be found.</div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Time <span>@Model.Entry.TimeEntryNumber.ToString("D8")</span></p>
            <h1>Edit Time</h1>
            <p class="text-muted">Draft and submitted entries can be amended. Approved or exported entries stay locked.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Entry.Id">Back</a>
    </div>

    <form method="post" class="mf-panel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.MatterId" class="form-label"></label>
                <select asp-for="Input.MatterId" class="form-select" data-time-matter-select data-system-increment-label="@Model.SystemIncrementLabel">
                    <option value="">Choose matter...</option>
                    @foreach (var matter in Model.MatterOptions)
                    {
                        <option value="@matter.Id"
                                selected="@(Model.Input.MatterId == matter.Id)"
                                data-requires-approval="@matter.RequiresApproval.ToString().ToLowerInvariant()"
                                data-increment="@matter.IncrementMinutes"
                                data-code-set="@matter.TimeCodeSetId">
                            @matter.Label
                        </option>
                    }
                </select>
                <span asp-validation-for="Input.MatterId" class="text-danger"></span>
                <small class="text-muted" data-time-rule-summary>Uses @Model.SystemIncrementLabel until a matter-specific rule is selected.</small>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.UserId" class="form-label"></label>
                <select asp-for="Input.UserId" asp-items="Model.UserOptions" class="form-select" disabled="@(!Model.CanRecordForOthers)">
                    <option value="">Choose user...</option>
                </select>
                @if (!Model.CanRecordForOthers)
                {
                    <input type="hidden" asp-for="Input.UserId" />
                }
                <span asp-validation-for="Input.UserId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.WorkDate" class="form-label"></label>
                <input asp-for="Input.WorkDate" class="form-control" type="date" />
                <span asp-validation-for="Input.WorkDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Hours" class="form-label"></label>
                <input asp-for="Input.Hours" class="form-control" type="number" min="0.01" max="24" step="0.1" data-time-hours />
                <span asp-validation-for="Input.Hours" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.TimePhaseId" class="form-label"></label>
                <select asp-for="Input.TimePhaseId" class="form-select" data-time-phase-select>
                    <option value="">No phase</option>
                    @foreach (var phase in Model.PhaseOptions)
                    {
                        <option value="@phase.Id"
                                selected="@(Model.Input.TimePhaseId == phase.Id)"
                                data-code-set="@phase.TimeCodeSetId">
                            @phase.Code - @phase.Name
                        </option>
                    }
                </select>
                <span asp-validation-for="Input.TimePhaseId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.TimeTaskId" class="form-label"></label>
                <select asp-for="Input.TimeTaskId" class="form-select" data-time-task-select>
                    <option value="">No task</option>
                    @foreach (var task in Model.TaskOptions)
                    {
                        <option value="@task.Id"
                                selected="@(Model.Input.TimeTaskId == task.Id)"
                                data-code-set="@task.TimeCodeSetId"
                                data-phase="@task.TimePhaseId">
                            @task.Code - @task.Name
                        </option>
                    }
                </select>
                <span asp-validation-for="Input.TimeTaskId" class="text-danger"></span>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="Input.IsBillable" class="form-check-input" />
                    <label asp-for="Input.IsBillable" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Input.ClientNarrative" class="form-label"></label>
                <textarea asp-for="Input.ClientNarrative" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Input.ClientNarrative" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Input.InternalNotes" class="form-label"></label>
                <textarea asp-for="Input.InternalNotes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.InternalNotes" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-outline-primary" type="submit" name="actionType" value="draft">Save draft</button>
            <button class="btn btn-primary" type="submit" name="actionType" value="submit">Submit</button>
            <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Entry.Id">Cancel</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const matterSelect = document.querySelector('[data-time-matter-select]');
            const phaseSelect = document.querySelector('[data-time-phase-select]');
            const taskSelect = document.querySelector('[data-time-task-select]');
            const summary = document.querySelector('[data-time-rule-summary]');
            const hoursInput = document.querySelector('[data-time-hours]');
            const systemIncrementLabel = matterSelect?.dataset.systemIncrementLabel ?? 'system default';

            function updateMatterRules() {
                const selected = matterSelect?.selectedOptions?.[0];
                const codeSet = selected?.dataset.codeSet ?? '';
                const increment = selected?.dataset.increment ?? '';
                const requiresApproval = selected?.dataset.requiresApproval === 'true';
                const incrementLabel = increment === '6'
                    ? '6-minute increments'
                    : increment === '15'
                        ? '15-minute increments'
                        : increment === '0'
                            ? 'actual time'
                            : systemIncrementLabel;

                if (summary) {
                    summary.textContent = `${incrementLabel}; ${requiresApproval ? 'partner approval required' : 'submitted time auto-approves'}.`;
                }

                if (hoursInput) {
                    hoursInput.step = increment === '15' ? '0.25' : increment === '6' || increment === '' ? '0.1' : '0.01';
                }

                filterOptions(phaseSelect, (option) => !option.value || option.dataset.codeSet === codeSet);
                if (phaseSelect && phaseSelect.selectedOptions[0]?.hidden) {
                    phaseSelect.value = '';
                }

                updateTasks();
            }

            function updateTasks() {
                const selectedMatter = matterSelect?.selectedOptions?.[0];
                const codeSet = selectedMatter?.dataset.codeSet ?? '';
                const phase = phaseSelect?.value ?? '';
                filterOptions(taskSelect, (option) => !option.value || (option.dataset.codeSet === codeSet && (!phase || option.dataset.phase === phase)));
                if (taskSelect && taskSelect.selectedOptions[0]?.hidden) {
                    taskSelect.value = '';
                }
            }

            function filterOptions(select, predicate) {
                if (!select) {
                    return;
                }

                Array.from(select.options).forEach((option) => {
                    option.hidden = !predicate(option);
                });
            }

            matterSelect?.addEventListener('change', updateMatterRules);
            phaseSelect?.addEventListener('change', updateTasks);
            updateMatterRules();
        })();
    </script>
}
