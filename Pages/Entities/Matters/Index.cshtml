@page
@model MatterForge.Pages.Entities.Matters.IndexModel
@{
    ViewData["Title"] = "Matters";
    ViewData["ActiveEntityTab"] = "Matters";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Matters</h1>
    </div>
    <a class="btn btn-primary" asp-page="./Create">Create matter</a>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="mf-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <strong>@(Model.Archived ? "Archived matters" : "Active matters")</strong>
            <small class="d-block text-muted">Archived records stay available for conflicts and can be restored from their detail page.</small>
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="Matter archive filter">
            <a class="btn @(Model.Archived ? "btn-outline-secondary" : "btn-primary")" asp-page="./Index">Active</a>
            <a class="btn @(Model.Archived ? "btn-primary" : "btn-outline-secondary")" asp-page="./Index" asp-route-archived="true">Archived</a>
        </div>
    </div>

    @if (Model.Matters.Count == 0)
    {
        <p class="text-muted mb-0">No @(Model.Archived ? "archived" : "active") matters found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Matter</th>
                        <th>Client</th>
                        <th>Practice area</th>
                        <th>Status</th>
                        <th>Responsible user</th>
                        <th>Opened</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var matter in Model.Matters)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@matter.Id"><code>@matter.MatterNumber.ToString("D8")</code></a></td>
                            <td>
                                <strong>@matter.Name</strong>
                            </td>
                            <td>@matter.Client?.Name</td>
                            <td>@matter.PracticeArea</td>
                            <td><span class="badge text-bg-primary">@matter.Status</span></td>
                            <td>@(matter.ResponsibleUser?.DisplayName ?? "Unassigned")</td>
                            <td>@matter.OpenedDate?.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
