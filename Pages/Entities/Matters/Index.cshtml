@page
@model CMIForge.Pages.Entities.Matters.IndexModel
@{
    ViewData["Title"] = "Matters";
    ViewData["ActiveEntityTab"] = "Matters";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Matters</h1>
    </div>
    <div class="mf-heading-actions">
        <partial name="/Pages/Shared/_ListSearch.cshtml" model='new CMIForge.Models.ListSearchViewModel(Model.Search, "Find matter...", "Search matters")' />
        <a class="btn btn-primary" asp-page="./Create">Create matter</a>
    </div>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="mf-panel">
    <div class="mb-3">
        <strong>Active matters</strong>
        <small class="d-block text-muted">Archived records stay available for conflicts and can be restored from System &gt; Archive.</small>
    </div>

    @if (Model.Matters.Count == 0)
    {
        <p class="text-muted mb-0">No active matters found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle" data-no-sort>
                <thead>
                    <tr>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "number")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="number" asp-route-sortDirection="@Model.NextSortDirection("number")">Number</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "matter")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="matter" asp-route-sortDirection="@Model.NextSortDirection("matter")">Matter</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "client")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="client" asp-route-sortDirection="@Model.NextSortDirection("client")">Client</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "practice")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="practice" asp-route-sortDirection="@Model.NextSortDirection("practice")">Practice area</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "status")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="status" asp-route-sortDirection="@Model.NextSortDirection("status")">Status</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "responsible")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="responsible" asp-route-sortDirection="@Model.NextSortDirection("responsible")">Responsible user</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "opened")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="opened" asp-route-sortDirection="@Model.NextSortDirection("opened")">Opened</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var matter in Model.Matters)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@matter.Id"><code>@matter.MatterNumber.ToString("D8")</code></a></td>
                            <td class="mf-truncate-cell">
                                <a class="mf-record-link" asp-page="./Details" asp-route-id="@matter.Id">
                                    <strong>@matter.Name</strong>
                                </a>
                            </td>
                            <td>@matter.Client?.Name</td>
                            <td>@matter.PracticeArea</td>
                            <td><span class="badge text-bg-primary">@matter.Status</span></td>
                            <td>@(matter.ResponsibleUser?.DisplayName ?? "Unassigned")</td>
                            <td>@matter.OpenedDate?.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="/Pages/Shared/_RecordPagination.cshtml" model='new CMIForge.Models.RecordPaginationViewModel(Model.Pagination, "active matters", Model.RouteValues)' />
    }
</div>
