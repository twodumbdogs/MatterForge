@page "{id:guid}"
@model CMIForge.Pages.Entities.Matters.DetailsModel
@{
    ViewData["Title"] = Model.Matter is null ? "Matter Details" : $"Matter {Model.Matter.MatterNumber:D8}";
    ViewData["ActiveEntityTab"] = "Matters";
}

@if (Model.Matter is null)
{
    <div class="alert alert-warning">That matter could not be found.</div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Matter <span>@Model.Matter.MatterNumber.ToString("D8")</span></p>
            <h1>@Model.Matter.Name</h1>
            <p class="text-muted">
                @Model.Matter.Client?.Name
                @if (Model.Matter.IsArchived)
                {
                    <span class="badge text-bg-secondary ms-2">Archived</span>
                }
            </p>
        </div>
        <div class="mf-hero-actions">
            @if (Model.CanEditEntities)
            {
                <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Matter.Id">Submit Change</a>
                <form method="post" asp-page-handler="Archive" asp-route-id="@Model.Matter.Id" class="d-inline">
                    <button class="btn btn-outline-secondary" type="submit">@(Model.Matter.IsArchived ? "Restore" : "Archive")</button>
                </form>
            }
            @if (Model.CanRunConflicts)
            {
                <a class="btn btn-outline-primary" asp-page="/Conflicts/Create" asp-route-matterId="@Model.Matter.Id">Run Conflict Search</a>
            }
            @if (Model.CanRecordTime)
            {
                <a class="btn btn-primary" asp-page="/Time/Create" asp-route-matterId="@Model.Matter.Id">Record Time</a>
            }
            <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        </div>
    </div>

    <partial name="/Pages/Entities/_EntityTabs.cshtml" />

    @if (CMIForge.Services.EntityComplianceService.IsReviewStatus(Model.Matter.Status))
    {
        <div class="alert alert-warning">
            This matter was created directly and is still in Compliance Review. Complete conflicts/compliance checks, then submit a change request to move it to Open.
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="mf-panel">
                <h2>Matter Details</h2>
                <dl class="row mt-3 mb-0">
                    <dt class="col-sm-5">Number</dt>
                    <dd class="col-sm-7"><code>@Model.Matter.MatterNumber.ToString("D8")</code></dd>
                    <dt class="col-sm-5">Client</dt>
                    <dd class="col-sm-7">
                        @if (Model.Matter.Client is not null)
                        {
                            <a asp-page="/Entities/Clients/Details" asp-route-id="@Model.Matter.Client.Id">@Model.Matter.Client.Name</a>
                        }
                    </dd>
                    <dt class="col-sm-5">Practice area</dt>
                    <dd class="col-sm-7">@Model.Matter.PracticeArea</dd>
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">@Model.Matter.Status</dd>
                    <dt class="col-sm-5">Responsible user</dt>
                    <dd class="col-sm-7">@(Model.Matter.ResponsibleUser?.DisplayName ?? "Unassigned")</dd>
                    <dt class="col-sm-5">Lead partner</dt>
                    <dd class="col-sm-7">@(Model.Matter.LeadPartner?.DisplayName ?? "Unassigned")</dd>
                    <dt class="col-sm-5">Time approval</dt>
                    <dd class="col-sm-7">@(Model.Matter.RequiresTimeApproval ? "Required" : "Not required")</dd>
                    <dt class="col-sm-5">Time increment</dt>
                    <dd class="col-sm-7">@(Model.Matter.TimeIncrementMinutes.HasValue ? CMIForge.Services.TimeIncrementRules.Label(Model.Matter.TimeIncrementMinutes.Value) : "System default")</dd>
                    <dt class="col-sm-5">Time code set</dt>
                    <dd class="col-sm-7">@(Model.Matter.TimeCodeSet?.Name ?? "None")</dd>
                    <dt class="col-sm-5">Opened</dt>
                    <dd class="col-sm-7">@Model.Matter.OpenedDate?.ToString("MMM d, yyyy")</dd>
                    <dt class="col-sm-5">Notes</dt>
                    <dd class="col-sm-7">@Model.Matter.Notes</dd>
                </dl>
            </div>

            @if (Model.PendingChanges.Count > 0)
            {
                <div class="mf-panel mt-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2>Pending Changes</h2>
                            <p class="text-muted mb-0">These updates have not been applied to the matter yet.</p>
                        </div>
                        <a class="btn btn-outline-primary" asp-page="/Entities/Approvals/Index">Review approvals</a>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Requested</th>
                                    <th>Requested by</th>
                                    <th>Summary</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var change in Model.PendingChanges)
                                {
                                    <tr>
                                        <td>@change.RequestedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                        <td>@change.RequestedByUser?.DisplayName</td>
                                        <td>@change.Summary</td>
                                        <td>@change.RequestNotes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="mt-3">
                <partial name="/Pages/Shared/_RecentInviteSends.cshtml" model="Model.RecentInviteSends" />
            </div>
        </div>
        <div class="col-lg-7">

    @if (Model.CanViewTime)
    {
        <div class="mf-panel mt-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>Time</h2>
                    <p class="text-muted mb-0">@Model.TotalTimeHours.ToString("0.00") total hours recorded on this matter.</p>
                </div>
                @if (Model.CanRecordTime)
                {
                    <a class="btn btn-outline-primary" asp-page="/Time/Create" asp-route-matterId="@Model.Matter.Id">Record time</a>
                }
            </div>
            @if (Model.Matter.TimeEntries.Count == 0)
            {
                <p class="text-muted mt-3 mb-0">No time has been recorded yet.</p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Date</th>
                                <th>User</th>
                                <th>Phase/task</th>
                                <th>Hours</th>
                                <th>Billable</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Matter.TimeEntries.OrderByDescending(x => x.WorkDate).Take(10))
                            {
                                <tr>
                                    <td><a asp-page="/Time/Details" asp-route-id="@entry.Id"><code>@entry.TimeEntryNumber.ToString("D8")</code></a></td>
                                    <td>@entry.WorkDate.ToString("MMM d, yyyy")</td>
                                    <td>@entry.User?.DisplayName</td>
                                    <td>
                                        @if (entry.TimePhase is not null)
                                        {
                                            <span>@entry.TimePhase.Code</span>
                                        }
                                        @if (entry.TimeTask is not null)
                                        {
                                            <small class="d-block text-muted">@entry.TimeTask.Code</small>
                                        }
                                    </td>
                                    <td>@((entry.Minutes / 60m).ToString("0.00"))</td>
                                    <td>@(entry.IsBillable ? "Yes" : "No")</td>
                                    <td>@entry.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <div class="mf-panel mt-3">
        <h2>Parties</h2>
        @if (Model.Matter.Parties.Count == 0)
        {
            <p class="text-muted mt-3 mb-0">No parties are linked to this matter yet.</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Party</th>
                            <th>Role</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var matterParty in Model.Matter.Parties.OrderBy(x => x.Role).ThenBy(x => x.Party?.Name))
                        {
                            <tr>
                                <td>
                                    @if (matterParty.Party is not null)
                                    {
                                        <a asp-page="/Entities/Parties/Details" asp-route-id="@matterParty.Party.Id">@matterParty.Party.Name</a>
                                    }
                                </td>
                                <td>@matterParty.Role</td>
                                <td>@matterParty.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="mf-panel mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <h2>Contacts</h2>
            <a class="btn btn-sm btn-outline-primary" asp-page="/Entities/Contacts/Index">Open address book</a>
        </div>
        @if (Model.Matter.Contacts.Count == 0)
        {
            <p class="text-muted mt-3 mb-0">No contacts are linked to this matter yet.</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Primary</th>
                            <th>Email</th>
                            <th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var link in Model.Matter.Contacts.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.Contact?.DisplayName))
                        {
                            <tr>
                                <td>
                                    @if (link.Contact is not null)
                                    {
                                        <a asp-page="/Entities/Contacts/Details" asp-route-id="@link.Contact.Id">@link.Contact.DisplayName</a>
                                    }
                                </td>
                                <td>@link.Role</td>
                                <td>@(link.IsPrimary ? "Yes" : "No")</td>
                                <td>@link.Contact?.Email</td>
                                <td>@link.Contact?.Phone</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

        </div>
    </div>

    <partial name="/Pages/Entities/_EntityNotes.cshtml" model="Model.Notes" />
    <partial name="/Pages/Entities/_EntityAuditHistory.cshtml" model="Model.AuditHistory" />
}
