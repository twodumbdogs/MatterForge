@using CMIForge.Models
@inject CMIForge.Services.CurrentUserService CurrentUserService
@model IReadOnlyList<EntityNote>
@{
    var actualUser = await CurrentUserService.GetActualCurrentUserAsync();
    var latestNotes = Model.Take(5).ToList();
    var olderNotes = Model.Skip(5).ToList();
}

<div class="mf-panel mt-3">
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div>
            <h2>Discussion</h2>
            <small class="text-muted">Leave notes and replies for the team.</small>
        </div>
        <span class="badge text-bg-light">@Model.Count note@(Model.Count == 1 ? string.Empty : "s")</span>
    </div>

    <div class="mf-note-thread mt-3">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No discussion yet. Start the thread with a note for the team.</p>
        }
        else
        {
            @foreach (var note in latestNotes)
            {
                var authorName = note.CreatedByUser?.DisplayName ?? "System";
                var impersonatedName = note.ImpersonatedUser?.DisplayName;
                var canDelete = actualUser?.Id == note.CreatedByUserId;

                <article class="mf-note-bubble">
                    <div class="mf-note-avatar">@Initials(authorName)</div>
                    <div class="mf-note-body">
                        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start">
                            <span>
                                <strong>@authorName</strong>
                                @if (!string.IsNullOrWhiteSpace(impersonatedName) &&
                                    !impersonatedName.Equals(authorName, StringComparison.OrdinalIgnoreCase))
                                {
                                    <small class="text-muted d-block">while impersonating @impersonatedName</small>
                                }
                            </span>
                            <span class="d-flex flex-wrap gap-2 align-items-center justify-content-end">
                                <small class="text-muted">@UserDates.Format(note.CreatedAt, "g")</small>
                                @if (canDelete)
                                {
                                    <form method="post" asp-page-handler="DeleteNote" class="d-inline">
                                        <input type="hidden" name="noteId" value="@note.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                    </form>
                                }
                            </span>
                        </div>
                        <p>@note.Body</p>
                    </div>
                </article>
            }
            @if (olderNotes.Count > 0)
            {
                <details class="mf-note-older">
                    <summary>Show @olderNotes.Count older note@(olderNotes.Count == 1 ? string.Empty : "s")</summary>
                    <div class="mf-note-thread mt-3">
                        @foreach (var note in olderNotes)
                        {
                            var authorName = note.CreatedByUser?.DisplayName ?? "System";
                            var impersonatedName = note.ImpersonatedUser?.DisplayName;
                            var canDelete = actualUser?.Id == note.CreatedByUserId;

                            <article class="mf-note-bubble">
                                <div class="mf-note-avatar">@Initials(authorName)</div>
                                <div class="mf-note-body">
                                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-start">
                                        <span>
                                            <strong>@authorName</strong>
                                            @if (!string.IsNullOrWhiteSpace(impersonatedName) &&
                                                !impersonatedName.Equals(authorName, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <small class="text-muted d-block">while impersonating @impersonatedName</small>
                                            }
                                        </span>
                                        <span class="d-flex flex-wrap gap-2 align-items-center justify-content-end">
                                            <small class="text-muted">@UserDates.Format(note.CreatedAt, "g")</small>
                                            @if (canDelete)
                                            {
                                                <form method="post" asp-page-handler="DeleteNote" class="d-inline">
                                                    <input type="hidden" name="noteId" value="@note.Id" />
                                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                                </form>
                                            }
                                        </span>
                                    </div>
                                    <p>@note.Body</p>
                                </div>
                            </article>
                        }
                    </div>
                </details>
            }
        }
    </div>

    <form method="post" asp-page-handler="Note" class="mt-3">
        <label class="form-label" for="new-note">Add note</label>
        <textarea id="new-note" name="NewNote" class="form-control" rows="3" maxlength="2000" placeholder="Type a note, update, or response..."></textarea>
        <button class="btn btn-primary mt-2" type="submit">Add note</button>
    </form>
</div>

@functions {
    private static string Initials(string? displayName)
    {
        var parts = (displayName ?? "CMIForge")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "CF";
        }

        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }
}
