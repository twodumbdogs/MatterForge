@using MatterForge.Models
@model IReadOnlyList<EntityNote>

<div class="mf-panel mt-3">
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div>
            <h2>Discussion</h2>
            <small class="text-muted">Leave notes and replies for the team.</small>
        </div>
        <span class="badge text-bg-light">@Model.Count note@(Model.Count == 1 ? string.Empty : "s")</span>
    </div>

    <div class="mf-note-thread mt-3">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No discussion yet. Start the thread with a note for the team.</p>
        }
        else
        {
            @foreach (var note in Model)
            {
                <article class="mf-note-bubble">
                    <div class="mf-note-avatar">@Initials(note.CreatedByUser?.DisplayName)</div>
                    <div class="mf-note-body">
                        <div class="d-flex flex-wrap gap-2 justify-content-between">
                            <strong>@(note.CreatedByUser?.DisplayName ?? "System")</strong>
                            <small class="text-muted">@UserDates.Format(note.CreatedAt, "g")</small>
                        </div>
                        <p>@note.Body</p>
                    </div>
                </article>
            }
        }
    </div>

    <form method="post" asp-page-handler="Note" class="mt-3">
        <label class="form-label" for="new-note">Add note</label>
        <textarea id="new-note" name="NewNote" class="form-control" rows="3" maxlength="2000" placeholder="Type a note, update, or response..."></textarea>
        <button class="btn btn-primary mt-2" type="submit">Add note</button>
    </form>
</div>

@functions {
    private static string Initials(string? displayName)
    {
        var parts = (displayName ?? "CMIForge")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "CF";
        }

        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }
}
