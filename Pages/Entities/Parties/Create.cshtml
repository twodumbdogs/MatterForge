@page
@model MatterForge.Pages.Entities.Parties.CreateModel
@{
    ViewData["Title"] = "Create Party";
    ViewData["ActiveEntityTab"] = "Parties";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Create Party</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<form method="post" class="mf-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.PartyType" class="form-label"></label>
            <select asp-for="Input.PartyType" asp-items="Model.PartyTypeOptions" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Status" class="form-label"></label>
            <input asp-for="Input.Status" class="form-control" />
        </div>
        <div class="col-md-8">
            <label asp-for="Input.Aliases" class="form-label"></label>
            <textarea asp-for="Input.Aliases" class="form-control" rows="3" placeholder="One alias per line"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label"></label>
            <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit">Create party</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
