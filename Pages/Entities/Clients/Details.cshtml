@page "{id:guid}"
@model CMIForge.Pages.Entities.Clients.DetailsModel
@{
    ViewData["Title"] = Model.Client is null ? "Client Details" : $"Client {Model.Client.ClientNumber:D8}";
    ViewData["ActiveEntityTab"] = "Clients";
}

@if (Model.Client is null)
{
    <div class="alert alert-warning">That client could not be found.</div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Client <span>@Model.Client.ClientNumber.ToString("D8")</span></p>
            <h1>@Model.Client.Name</h1>
            <p class="text-muted">
                @Model.Client.Status
                @if (Model.Client.IsArchived)
                {
                    <span class="badge text-bg-secondary ms-2">Archived</span>
                }
            </p>
        </div>
        <div class="mf-hero-actions">
            @if (Model.CanEditEntities)
            {
                <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Client.Id">Submit Change</a>
                <form method="post" asp-page-handler="Archive" asp-route-id="@Model.Client.Id" class="d-inline">
                    <button class="btn btn-outline-secondary" type="submit">@(Model.Client.IsArchived ? "Restore" : "Archive")</button>
                </form>
            }
            <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        </div>
    </div>

    <partial name="/Pages/Entities/_EntityTabs.cshtml" />

    @if (CMIForge.Services.EntityComplianceService.IsReviewStatus(Model.Client.Status))
    {
        <div class="alert alert-warning">
            This client was created directly and is still in Compliance Review. Complete conflicts/compliance checks, then submit a change request to move it to Active.
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="mf-panel">
                <h2>Client Details</h2>
                <dl class="row mt-3 mb-0">
                    <dt class="col-sm-5">Number</dt>
                    <dd class="col-sm-7"><code>@Model.Client.ClientNumber.ToString("D8")</code></dd>
                    <dt class="col-sm-5">Primary contact</dt>
                    <dd class="col-sm-7">@Model.Client.PrimaryContact</dd>
                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">@Model.Client.Email</dd>
                    <dt class="col-sm-5">Phone</dt>
                    <dd class="col-sm-7">@Model.Client.Phone</dd>
                    <dt class="col-sm-5">Address</dt>
                    <dd class="col-sm-7">
                        @if (string.IsNullOrWhiteSpace(Model.Client.AddressLine1) &&
                             string.IsNullOrWhiteSpace(Model.Client.City) &&
                             string.IsNullOrWhiteSpace(Model.Client.State))
                        {
                            <span class="text-muted">Not set</span>
                        }
                        else
                        {
                            <div>@Model.Client.AddressLine1</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Client.AddressLine2))
                            {
                                <div>@Model.Client.AddressLine2</div>
                            }
                            <div>@string.Join(", ", new[] { Model.Client.City, Model.Client.State }.Where(x => !string.IsNullOrWhiteSpace(x))) @Model.Client.PostalCode</div>
                            <div>@Model.Client.Country</div>
                        }
                    </dd>
                    <dt class="col-sm-5">Notes</dt>
                    <dd class="col-sm-7">@Model.Client.Notes</dd>
                </dl>
            </div>

            <div class="mf-panel mt-3">
                <h2>Add Alias</h2>
                @if (Model.CanEditEntities)
                {
                    <form method="post" asp-page-handler="Alias" asp-route-id="@Model.Client.Id" class="row g-2 mt-2">
                        <div class="col-12">
                            <input asp-for="AliasInput.Alias" class="form-control" placeholder="DBA, prior name, or alternate spelling" />
                            <span asp-validation-for="AliasInput.Alias" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <input asp-for="AliasInput.Notes" class="form-control" placeholder="Notes" />
                            <span asp-validation-for="AliasInput.Notes" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-sm btn-primary" type="submit">Add alias</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted mt-2 mb-0">Alias maintenance requires entity edit access.</p>
                }
            </div>
        </div>
        <div class="col-lg-7">
            <div class="mf-panel mb-3">
                <h2>Aliases</h2>
                @if (Model.Client.Aliases.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">No aliases yet.</p>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Alias</th>
                                    <th>Normalized</th>
                                    <th>Notes</th>
                                    @if (Model.CanEditEntities)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alias in Model.Client.Aliases.OrderBy(x => x.Alias))
                                {
                                    <tr>
                                        @if (Model.CanEditEntities)
                                        {
                                            <td colspan="4">
                                                <form method="post" asp-page-handler="UpdateAlias" asp-route-id="@Model.Client.Id" class="row g-2 align-items-start">
                                                    <input type="hidden" name="AliasEditInput.Id" value="@alias.Id" />
                                                    <div class="col-md-4">
                                                        <input class="form-control form-control-sm" name="AliasEditInput.Alias" value="@alias.Alias" />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <code>@alias.NormalizedAlias</code>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <input class="form-control form-control-sm" name="AliasEditInput.Notes" value="@alias.Notes" />
                                                    </div>
                                                    <div class="col-md-2 d-flex gap-2">
                                                        <button class="btn btn-sm btn-primary" type="submit">Save</button>
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                type="submit"
                                                                formmethod="post"
                                                                formaction="@Url.Page("./Details", "DeleteAlias", new { id = Model.Client.Id, aliasId = alias.Id })">
                                                            Delete
                                                        </button>
                                                    </div>
                                                </form>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>@alias.Alias</td>
                                            <td><code>@alias.NormalizedAlias</code></td>
                                            <td>@alias.Notes</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="mf-panel">
                <h2>Matters</h2>
                @if (Model.Client.Matters.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">No matters are linked to this client yet.</p>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Number</th>
                                    <th>Matter</th>
                                    <th>Status</th>
                                    <th>Responsible user</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var matter in Model.Client.Matters.OrderBy(x => x.MatterNumber))
                                {
                                    <tr>
                                        <td><a asp-page="/Entities/Matters/Details" asp-route-id="@matter.Id"><code>@matter.MatterNumber.ToString("D8")</code></a></td>
                                        <td>@matter.Name</td>
                                        <td>@matter.Status</td>
                                        <td>@(matter.ResponsibleUser?.DisplayName ?? "Unassigned")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="mf-panel mt-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h2>Contacts</h2>
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Entities/Contacts/Index">Open address book</a>
                </div>
                @if (Model.Client.Contacts.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">No contacts are linked to this client yet.</p>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Contact</th>
                                    <th>Role</th>
                                    <th>Primary</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var link in Model.Client.Contacts.OrderByDescending(x => x.IsPrimary).ThenBy(x => x.Contact?.DisplayName))
                                {
                                    <tr>
                                        <td>
                                            @if (link.Contact is not null)
                                            {
                                                <a asp-page="/Entities/Contacts/Details" asp-route-id="@link.Contact.Id">@link.Contact.DisplayName</a>
                                            }
                                        </td>
                                        <td>@link.Role</td>
                                        <td>@(link.IsPrimary ? "Yes" : "No")</td>
                                        <td>@link.Contact?.Email</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="mf-panel mt-3">
                <h2>Related Parties</h2>
                @if (Model.RelatedParties.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">No parties are linked through this client's matters yet.</p>
                }
                else
                {
                    <div class="table-responsive mt-3">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Party</th>
                                    <th>Matter</th>
                                    <th>Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var party in Model.RelatedParties)
                                {
                                    <tr>
                                        <td><a asp-page="/Entities/Parties/Details" asp-route-id="@party.PartyId">@party.PartyNumber.ToString("D8") - @party.PartyName</a></td>
                                        <td><a asp-page="/Entities/Matters/Details" asp-route-id="@party.MatterId">@party.MatterNumber.ToString("D8") - @party.MatterName</a></td>
                                        <td>@party.Role</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.PendingChanges.Count > 0)
    {
        <div class="mf-panel mt-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>Pending Changes</h2>
                    <p class="text-muted mb-0">These updates have not been applied to the client yet.</p>
                </div>
                <a class="btn btn-outline-primary" asp-page="/Entities/Approvals/Index">Review approvals</a>
            </div>
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Requested</th>
                            <th>Requested by</th>
                            <th>Summary</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in Model.PendingChanges)
                        {
                            <tr>
                                <td>@change.RequestedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td>@change.RequestedByUser?.DisplayName</td>
                                <td>@change.Summary</td>
                                <td>@change.RequestNotes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <partial name="/Pages/Entities/_EntityNotes.cshtml" model="Model.Notes" />
    <partial name="/Pages/Entities/_EntityAuditHistory.cshtml" model="Model.AuditHistory" />
}
