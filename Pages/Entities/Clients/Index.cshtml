@page
@model MatterForge.Pages.Entities.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
    ViewData["ActiveEntityTab"] = "Clients";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Clients</h1>
    </div>
    <a class="btn btn-primary" asp-page="./Create">Create client</a>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="mf-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <strong>@(Model.Archived ? "Archived clients" : "Active clients")</strong>
            <small class="d-block text-muted">Archived records stay searchable and can be restored from their detail page.</small>
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="Client archive filter">
            <a class="btn @(Model.Archived ? "btn-outline-secondary" : "btn-primary")" asp-page="./Index">Active</a>
            <a class="btn @(Model.Archived ? "btn-primary" : "btn-outline-secondary")" asp-page="./Index" asp-route-archived="true">Archived</a>
        </div>
    </div>

    @if (Model.Clients.Count == 0)
    {
        <p class="text-muted mb-0">No @(Model.Archived ? "archived" : "active") clients found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Primary contact</th>
                        <th>Email</th>
                        <th>Matters</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@client.Id"><code>@client.ClientNumber.ToString("D8")</code></a></td>
                            <td>
                                <strong>@client.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(client.Notes))
                                {
                                    <small class="d-block text-muted">@client.Notes</small>
                                }
                            </td>
                            <td><span class="badge text-bg-success">@client.Status</span></td>
                            <td>@client.PrimaryContact</td>
                            <td>@client.Email</td>
                            <td>@client.Matters.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
