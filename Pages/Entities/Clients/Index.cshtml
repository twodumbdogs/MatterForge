@page
@model CMIForge.Pages.Entities.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
    ViewData["ActiveEntityTab"] = "Clients";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Clients</h1>
    </div>
    <div class="mf-heading-actions">
        <partial name="/Pages/Shared/_ListSearch.cshtml" model='new CMIForge.Models.ListSearchViewModel(Model.Search, "Find client...", "Search clients")' />
        <a class="btn btn-primary" asp-page="./Create">Create client</a>
    </div>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="mf-panel">
    <div class="mb-3">
        <strong>Active clients</strong>
        <small class="d-block text-muted">Archived records stay searchable and can be restored from System &gt; Archive.</small>
    </div>

    @if (Model.Clients.Count == 0)
    {
        <p class="text-muted mb-0">No active clients found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mf-compact-table" data-no-sort>
                <thead>
                    <tr>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "number")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="number" asp-route-sortDirection="@Model.NextSortDirection("number")">Number</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "name")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="name" asp-route-sortDirection="@Model.NextSortDirection("name")">Name</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "status")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="status" asp-route-sortDirection="@Model.NextSortDirection("status")">Status</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "primary")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="primary" asp-route-sortDirection="@Model.NextSortDirection("primary")">Primary contact</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "email")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="email" asp-route-sortDirection="@Model.NextSortDirection("email")">Email</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "aliases")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="aliases" asp-route-sortDirection="@Model.NextSortDirection("aliases")">Aliases</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "matters")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="matters" asp-route-sortDirection="@Model.NextSortDirection("matters")">Matters</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@client.Id"><code>@client.ClientNumber.ToString("D8")</code></a></td>
                            <td class="mf-truncate-cell"><a asp-page="./Details" asp-route-id="@client.Id"><strong>@client.Name</strong></a></td>
                            <td><span class="badge text-bg-success">@client.Status</span></td>
                            <td>@client.PrimaryContact</td>
                            <td>@client.Email</td>
                            <td>@client.Aliases.Count</td>
                            <td>@client.Matters.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="/Pages/Shared/_RecordPagination.cshtml" model='new CMIForge.Models.RecordPaginationViewModel(Model.Pagination, "active clients", Model.RouteValues)' />
    }
</div>
