@page "{id:guid}"
@model CMIForge.Pages.Entities.Clients.EditModel
@{
    ViewData["Title"] = Model.Client is null ? "Edit Client" : $"Edit Client {Model.Client.ClientNumber:D8}";
    ViewData["ActiveEntityTab"] = "Clients";
}

@if (Model.Client is null)
{
    <div class="alert alert-warning">That client could not be found.</div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Client <span>@Model.Client.ClientNumber.ToString("D8")</span></p>
            <h1>Submit Client Change</h1>
            <p class="text-muted">Changes are held for approval before the client record is updated.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Client.Id">Back</a>
    </div>

    <partial name="/Pages/Entities/_EntityTabs.cshtml" />

    @if (CMIForge.Services.EntityComplianceService.IsReviewStatus(Model.Client.Status))
    {
        <div class="alert alert-warning">
            This client is in Compliance Review because it was created directly. Add review notes before requesting Active status.
        </div>
    }

    <form method="post" class="mf-panel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Status" class="form-label"></label>
                <select asp-for="Input.Status" class="form-select">
                    @foreach (var status in Model.StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-8">
                <label asp-for="Input.PrimaryContact" class="form-label"></label>
                <input asp-for="Input.PrimaryContact" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Phone" class="form-label"></label>
                <input asp-for="Input.Phone" class="form-control" />
            </div>
            <div class="col-md-8">
                <label asp-for="Input.AddressLine1" class="form-label"></label>
                <input asp-for="Input.AddressLine1" class="form-control" autocomplete="street-address" data-address-lookup-input data-address-field="line1" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.AddressLine2" class="form-label"></label>
                <input asp-for="Input.AddressLine2" class="form-control" data-address-field="line2" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.City" class="form-label"></label>
                <input asp-for="Input.City" class="form-control" data-address-field="city" />
            </div>
            <div class="col-md-3">
                <label asp-for="Input.State" class="form-label"></label>
                <input asp-for="Input.State" class="form-control" data-address-field="state" />
            </div>
            <div class="col-md-2">
                <label asp-for="Input.PostalCode" class="form-label"></label>
                <input asp-for="Input.PostalCode" class="form-control" data-address-field="postalCode" />
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Country" class="form-label"></label>
                <input asp-for="Input.Country" class="form-control" data-address-field="country" />
            </div>
            <div class="col-12">
                <label asp-for="Input.Notes" class="form-label"></label>
                <textarea asp-for="Input.Notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="Input.RequestNotes" class="form-label"></label>
                <textarea asp-for="Input.RequestNotes" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Submit for approval</button>
            <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Client.Id">Cancel</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/address-lookup.js" asp-append-version="true"></script>
}
