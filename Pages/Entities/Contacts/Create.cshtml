@page
@model CMIForge.Pages.Entities.Contacts.CreateModel
@{
    ViewData["Title"] = "Create Contact";
    ViewData["ActiveEntityTab"] = "Contacts";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Create Contact</h1>
        <p class="text-muted">Create an address-book contact. Contacts can be linked to clients and matters after creation.</p>
    </div>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="alert alert-info">
    <strong>Direct entity creation:</strong> This contact is being created directly instead of from an approved workflow.
    Link it to the appropriate client/matter and use notes or audit history to document any compliance context.
</div>

<form method="post" class="mf-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Input.FirstName" class="form-label"></label>
            <input asp-for="Input.FirstName" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.MiddleName" class="form-label"></label>
            <input asp-for="Input.MiddleName" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.LastName" class="form-label"></label>
            <input asp-for="Input.LastName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Organization" class="form-label"></label>
            <input asp-for="Input.Organization" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Phone" class="form-label"></label>
            <input asp-for="Input.Phone" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.MobilePhone" class="form-label"></label>
            <input asp-for="Input.MobilePhone" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Input.AddressLine1" class="form-label"></label>
            <input asp-for="Input.AddressLine1" class="form-control" autocomplete="street-address" data-address-lookup-input data-address-field="line1" />
        </div>
        <div class="col-md-6">
            <label asp-for="Input.AddressLine2" class="form-label"></label>
            <input asp-for="Input.AddressLine2" class="form-control" data-address-field="line2" />
        </div>
        <div class="col-md-3">
            <label asp-for="Input.City" class="form-label"></label>
            <input asp-for="Input.City" class="form-control" data-address-field="city" />
        </div>
        <div class="col-md-3">
            <label asp-for="Input.State" class="form-label"></label>
            <input asp-for="Input.State" class="form-control" data-address-field="state" />
        </div>
        <div class="col-md-3">
            <label asp-for="Input.PostalCode" class="form-label"></label>
            <input asp-for="Input.PostalCode" class="form-control" data-address-field="postalCode" />
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Country" class="form-label"></label>
            <input asp-for="Input.Country" class="form-control" data-address-field="country" />
        </div>
        <div class="col-12">
            <label asp-for="Input.Notes" class="form-label"></label>
            <textarea asp-for="Input.Notes" class="form-control" rows="4"></textarea>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit">Create contact</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/address-lookup.js" asp-append-version="true"></script>
}
