@page
@model CMIForge.Pages.Entities.Contacts.IndexModel
@{
    ViewData["Title"] = "Contacts";
    ViewData["ActiveEntityTab"] = "Contacts";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Contacts</h1>
        <p class="text-muted">Address-book contacts that can link to clients and matters without becoming CMIForge users.</p>
    </div>
    <div class="mf-heading-actions">
        <partial name="/Pages/Shared/_ListSearch.cshtml" model='new CMIForge.Models.ListSearchViewModel(Model.Search, "Find contact...", "Search contacts")' />
        <a class="btn btn-primary" asp-page="./Create">Create contact</a>
    </div>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="mf-panel">
    @if (Model.Contacts.Count == 0)
    {
        <p class="text-muted mb-0">No contacts yet. Add people here when they should be available across clients and matters but should not log into CMIForge.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle" data-no-sort>
                <thead>
                    <tr>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "number")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="number" asp-route-sortDirection="@Model.NextSortDirection("number")">Number</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "name")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="name" asp-route-sortDirection="@Model.NextSortDirection("name")">Name</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "organization")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="organization" asp-route-sortDirection="@Model.NextSortDirection("organization")">Organization</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "email")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="email" asp-route-sortDirection="@Model.NextSortDirection("email")">Email</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "phone")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="phone" asp-route-sortDirection="@Model.NextSortDirection("phone")">Phone</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "client-links")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="client-links" asp-route-sortDirection="@Model.NextSortDirection("client-links")">Client links</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "matter-links")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="matter-links" asp-route-sortDirection="@Model.NextSortDirection("matter-links")">Matter links</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Model.Contacts)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@contact.Id"><code>@contact.ContactNumber.ToString("D8")</code></a></td>
                            <td>
                                <a class="mf-record-link" asp-page="./Details" asp-route-id="@contact.Id">
                                    <strong>@contact.DisplayName</strong>
                                    @if (!string.IsNullOrWhiteSpace(contact.Title))
                                    {
                                        <small class="d-block text-muted">@contact.Title</small>
                                    }
                                </a>
                            </td>
                            <td>@contact.Organization</td>
                            <td>@contact.Email</td>
                            <td>@contact.Phone</td>
                            <td>@contact.ClientLinks.Count</td>
                            <td>@contact.MatterLinks.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="/Pages/Shared/_RecordPagination.cshtml" model='new CMIForge.Models.RecordPaginationViewModel(Model.Pagination, "contacts", Model.RouteValues)' />
    }
</div>
