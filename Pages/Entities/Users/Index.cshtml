@page
@model CMIForge.Pages.Entities.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    ViewData["ActiveEntityTab"] = "Users";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Users</h1>
    </div>
    <div class="mf-heading-actions">
        <partial name="/Pages/Shared/_ListSearch.cshtml" model='new CMIForge.Models.ListSearchViewModel(Model.Search, "Find user...", "Search users")' />
        <a class="btn btn-primary" asp-page="./Create">Create user</a>
    </div>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="mf-panel">
    <div class="mb-3">
        <strong>Active users</strong>
        <small class="d-block text-muted">Archived users are hidden here and can be restored from System &gt; Archive.</small>
    </div>

    @if (Model.Users.Count == 0)
    {
        <p class="text-muted mb-0">No active users found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle" data-no-sort>
                <thead>
                    <tr>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "system-id")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="system-id" asp-route-sortDirection="@Model.NextSortDirection("system-id")">System ID</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "name")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="name" asp-route-sortDirection="@Model.NextSortDirection("name")">Name</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "first")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="first" asp-route-sortDirection="@Model.NextSortDirection("first")">First</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "last")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="last" asp-route-sortDirection="@Model.NextSortDirection("last")">Last</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "email")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="email" asp-route-sortDirection="@Model.NextSortDirection("email")">Email</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "title")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="title" asp-route-sortDirection="@Model.NextSortDirection("title")">Title / role</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "status")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="status" asp-route-sortDirection="@Model.NextSortDirection("status")">Status</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "last-login")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="last-login" asp-route-sortDirection="@Model.NextSortDirection("last-login")">Last login</a></th>
                        <th class="@CMIForge.Models.ListSort.HeaderClass(Model.SortColumn, "responsible")"><a asp-route-pageNumber="1" asp-route-search="@Model.Search" asp-route-sortColumn="responsible" asp-route-sortDirection="@Model.NextSortDirection("responsible")">Responsible matters</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@user.Id"><code>@user.SystemId.ToString("D8")</code></a></td>
                            <td><a asp-page="./Details" asp-route-id="@user.Id"><strong>@user.DisplayName</strong></a></td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Email</td>
                            <td>@user.Title</td>
                            <td><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                            <td>@(user.LastLoginAt.HasValue ? UserDates.Format(user.LastLoginAt.Value) : "Never")</td>
                            <td>@user.ResponsibleMatters.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="/Pages/Shared/_RecordPagination.cshtml" model='new CMIForge.Models.RecordPaginationViewModel(Model.Pagination, "active users", Model.RouteValues)' />
    }
</div>
