@page
@model MatterForge.Pages.Entities.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    ViewData["ActiveEntityTab"] = "Users";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Users</h1>
    </div>
    <a class="btn btn-primary" asp-page="./Create">Create user</a>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="mf-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <strong>@(Model.Archived ? "Archived users" : "Active users")</strong>
            <small class="d-block text-muted">Archived users are hidden from this list but can be restored from their detail page.</small>
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="User archive filter">
            <a class="btn @(Model.Archived ? "btn-outline-secondary" : "btn-primary")" asp-page="./Index">Active</a>
            <a class="btn @(Model.Archived ? "btn-primary" : "btn-outline-secondary")" asp-page="./Index" asp-route-archived="true">Archived</a>
        </div>
    </div>

    @if (Model.Users.Count == 0)
    {
        <p class="text-muted mb-0">No @(Model.Archived ? "archived" : "active") users found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>System ID</th>
                        <th>Name</th>
                        <th>First</th>
                        <th>Last</th>
                        <th>Email</th>
                        <th>Title / role</th>
                        <th>Status</th>
                        <th>Last login</th>
                        <th>Responsible matters</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@user.Id"><code>@user.SystemId.ToString("D8")</code></a></td>
                            <td><a asp-page="./Details" asp-route-id="@user.Id"><strong>@user.DisplayName</strong></a></td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Email</td>
                            <td>@user.Title</td>
                            <td><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                            <td>@(user.LastLoginAt.HasValue ? UserDates.Format(user.LastLoginAt.Value) : "Never")</td>
                            <td>@user.ResponsibleMatters.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
