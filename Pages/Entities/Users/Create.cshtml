@page
@model CMIForge.Pages.Entities.Users.CreateModel
@{
    ViewData["Title"] = "Create User";
    ViewData["ActiveEntityTab"] = "Users";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Entities</p>
        <h1>Create User</h1>
    </div>
</div>

<partial name="/Pages/Entities/_EntityTabs.cshtml" />

<div class="alert @(Model.UserLimit.CanCreate ? "alert-info" : "alert-warning")">
    @Model.UserLimit.Message
</div>

<form method="post" class="mf-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Input.FirstName" class="form-label"></label>
            <input asp-for="Input.FirstName" class="form-control" />
            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.MiddleName" class="form-label"></label>
            <input asp-for="Input.MiddleName" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.LastName" class="form-label"></label>
            <input asp-for="Input.LastName" class="form-control" />
            <span asp-validation-for="Input.LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
            <div class="form-text">This is the email CMIForge stores for contact and notifications. It does not have to match the Entra login.</div>
        </div>
        <div class="col-md-8">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="Input.IsPartner" class="form-check-input" />
                <label asp-for="Input.IsPartner" class="form-check-label"></label>
                <div class="form-text">Allows this user to be selected as lead partner.</div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row g-3">
        <div class="col-12">
            <h2 class="h5 mb-2">Entra Login</h2>
            @if (Model.EntraProvisioningConfigured)
            {
                <p class="text-muted mb-0">
                    Create a Microsoft Entra login in this tenant. The username becomes
                    <code>username@@@Model.EntraDomain</code> and does not require a mailbox.
                </p>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Entra user provisioning is not enabled for this tenant yet. You can still create the CMIForge user record now and bind Entra identity later.
                </div>
            }
        </div>
        <div class="col-md-4">
            <div class="form-check mt-2">
                <input asp-for="Input.CreateEntraLogin" class="form-check-input" disabled="@(!Model.EntraProvisioningConfigured)" />
                <label asp-for="Input.CreateEntraLogin" class="form-check-label"></label>
            </div>
            <span asp-validation-for="Input.CreateEntraLogin" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Input.EntraUserName" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Input.EntraUserName" class="form-control" disabled="@(!Model.EntraProvisioningConfigured)" />
                <span class="input-group-text">@@@Model.EntraDomain</span>
            </div>
            <span asp-validation-for="Input.EntraUserName" class="text-danger"></span>
            <div class="form-text">Use letters, numbers, periods, underscores, or hyphens.</div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        @if (Model.UserLimit.CanCreate)
        {
            <button class="btn btn-primary" type="submit">Create user</button>
        }
        else
        {
            <button class="btn btn-primary" type="submit" disabled>Create user</button>
        }
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
