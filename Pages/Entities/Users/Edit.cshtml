@page "{id:guid}"
@model CMIForge.Pages.Entities.Users.EditModel
@{
    ViewData["Title"] = Model.UserRecord is null ? "Edit User" : $"Edit User {Model.UserRecord.SystemId:D8}";
    ViewData["ActiveEntityTab"] = "Users";
}

@if (Model.UserRecord is null)
{
    <div class="alert alert-warning">That user could not be found.</div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">User <span>@Model.UserRecord.SystemId.ToString("D8")</span></p>
            <h1>Edit User</h1>
            <p class="text-muted">@Model.UserRecord.DisplayName</p>
        </div>
    </div>

    <partial name="/Pages/Entities/_EntityTabs.cshtml" />

    @if (Model.IsEditLocked)
    {
        <div class="alert alert-info">@Model.ProtectedUserMessage</div>
        <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.UserRecord.Id">Back to user</a>
    }
    else
    {
        <form method="post" class="mf-panel">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.FirstName" class="form-label"></label>
                    <input asp-for="Input.FirstName" class="form-control" />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.MiddleName" class="form-label"></label>
                    <input asp-for="Input.MiddleName" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.LastName" class="form-label"></label>
                    <input asp-for="Input.LastName" class="form-control" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="Input.IsPartner" class="form-check-input" />
                        <label asp-for="Input.IsPartner" class="form-check-label"></label>
                        <div class="form-text">Allows this user to be selected as lead partner.</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">Save user</button>
                <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.UserRecord.Id">Cancel</a>
            </div>
        </form>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
