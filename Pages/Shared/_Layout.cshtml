<!DOCTYPE html>
@inject CMIForge.Services.PermissionService Permissions
@inject CMIForge.Services.CurrentUserService CurrentUserService
@inject CMIForge.Services.ProductPlanService ProductPlans
@inject CMIForge.Services.DemoModeService DemoMode
@inject CMIForge.Services.TenantBrandingService TenantBranding
@{
    var path = ViewContext.HttpContext.Request.Path;
    var canViewForms = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.FormsView);
    var canViewSubmissions = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.SubmissionsViewAll)
        || await Permissions.HasAsync(CMIForge.Services.PermissionKeys.SubmissionsViewOwn);
    var canViewWorkflowQueue = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.WorkflowsViewQueue)
        && ProductPlans.AllowsFeature(CMIForge.Services.ProductFeatureKeys.Workflow);
    var canDesignWorkflows = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.WorkflowsDesign)
        && ProductPlans.AllowsFeature(CMIForge.Services.ProductFeatureKeys.Workflow);
    var canViewConflicts = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.ConflictsView);
    var canViewTime = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.TimeViewAll)
        || await Permissions.HasAsync(CMIForge.Services.PermissionKeys.TimeViewOwn);
    var canViewReports = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.ReportingView)
        && ProductPlans.AllowsFeature(CMIForge.Services.ProductFeatureKeys.Reporting);
    var canViewImports = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.ImportsView);
    var canViewEntities = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.EntitiesView);
    var canManageSecurity = await Permissions.HasAsync(CMIForge.Services.PermissionKeys.SecurityManage);
    var canImpersonateUsers = await Permissions.HasAsActualUserAsync(CMIForge.Services.PermissionKeys.SystemImpersonateUsers);
    var impersonationContext = await CurrentUserService.GetImpersonationContextAsync();
    var layoutCurrentUser = await CurrentUserService.GetCurrentUserAsync();
    var fontScalePercent = layoutCurrentUser?.FontScalePercent is 90 or 100 or 115 or 130
        ? layoutCurrentUser.FontScalePercent
        : 100;
    var rootFontSizePx = (15m * fontScalePercent / 100m).ToString("0.##", global::System.Globalization.CultureInfo.InvariantCulture);
    var signedInLabel =
        !string.IsNullOrWhiteSpace(layoutCurrentUser?.FirstName)
            ? layoutCurrentUser.FirstName
            : !string.IsNullOrWhiteSpace(layoutCurrentUser?.DisplayName)
                ? layoutCurrentUser.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? layoutCurrentUser.DisplayName
                : !string.IsNullOrWhiteSpace(CurrentUserService.GetAuthenticatedEmail())
                    ? CurrentUserService.GetAuthenticatedEmail()?.Split('@', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Signed in"
                    : "Signed in";
    var showSystemMenu = true;
    var isSubmissionSection = path.StartsWithSegments("/Submissions")
        || path.StartsWithSegments("/Workflow/Queue");
    var isSystemSection = path.StartsWithSegments("/Forms")
        || path.StartsWithSegments("/Workflow/Definitions")
        || path.StartsWithSegments("/Imports")
        || path.StartsWithSegments("/Security")
        || path.StartsWithSegments("/System");
    var tenantDisplayName = await TenantBranding.GetDisplayNameAsync();
    var currentPlan = ProductPlans.CurrentPlan;
}
<html lang="en" style="--mf-root-font-size: @(rootFontSizePx)px;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMIForge</title>
    <script type="importmap"></script>
    <script>
        (() => {
            const storageKey = 'cmiforge.theme';
            const savedTheme = localStorage.getItem(storageKey);
            const prefersDark = window.matchMedia?.('(prefers-color-scheme: dark)').matches ?? false;
            const theme = savedTheme === 'light' || savedTheme === 'dark'
                ? savedTheme
                : prefersDark ? 'dark' : 'light';

            document.documentElement.dataset.bsTheme = theme;
            document.documentElement.dataset.theme = theme;
        })();
    </script>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CMIForge.styles.css" asp-append-version="true" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/img/cmiforge-logo-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/img/cmiforge-logo-180.png" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mf-nav border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand mf-brand-lockup" asp-area="" asp-page="/Index">
                    <img src="/img/cmiforge-logo.png" alt="" class="mf-brand-mark" />
                    <span>@tenantDisplayName</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (canViewSubmissions || canViewWorkflowQueue)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(isSubmissionSection ? "active" : null)"
                                   href="#"
                                   id="submissionsNavDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Submissions
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="submissionsNavDropdown">
                                    @if (canViewSubmissions)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/Submissions") ? "active" : null)" asp-area="" asp-page="/Submissions/Index">Submissions</a>
                                        </li>
                                    }
                                    @if (canViewWorkflowQueue)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/Workflow/Queue") ? "active" : null)" asp-area="" asp-page="/Workflow/Queue">Workflow Queue</a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (canViewEntities)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(path.StartsWithSegments("/Entities") ? "active" : null)" asp-area="" asp-page="/Entities/Clients/Index">Entities</a>
                            </li>
                        }
                        @if (canViewConflicts)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(path.StartsWithSegments("/Conflicts") ? "active" : null)" asp-area="" asp-page="/Conflicts/Index">Conflicts</a>
                            </li>
                        }
                        @if (canViewTime)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(path.StartsWithSegments("/Time") ? "active" : null)" asp-area="" asp-page="/Time/Index">Time</a>
                            </li>
                        }
                        @if (canViewReports)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(path.StartsWithSegments("/Reports") ? "active" : null)" asp-area="" asp-page="/Reports/Index">Reports</a>
                            </li>
                        }
                        @if (showSystemMenu)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(isSystemSection ? "active" : null)"
                                   href="#"
                                   id="systemNavDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    System
                                </a>
                                <ul class="dropdown-menu mf-system-menu" aria-labelledby="systemNavDropdown">
                                    @if (canViewForms)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/Forms") ? "active" : null)" asp-area="" asp-page="/Forms/Index">Forms</a>
                                        </li>
                                    }
                                    @if (canDesignWorkflows)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/Workflow/Definitions") ? "active" : null)" asp-area="" asp-page="/Workflow/Definitions/Index">Workflows</a>
                                        </li>
                                    }
                                    @if (canViewImports)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/Imports") ? "active" : null)" asp-area="" asp-page="/Imports/Index">Imports/Exports</a>
                                        </li>
                                    }
                                    @if (canManageSecurity)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/Security") ? "active" : null)" asp-area="" asp-page="/Security/Index">Security</a>
                                        </li>
                                    }
                                    @if (canImpersonateUsers)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/Security/Impersonation") ? "active" : null)" asp-area="" asp-page="/Security/Impersonation">Impersonation</a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item @(path.StartsWithSegments("/System/EnhancementRequests") ? "active" : null)" asp-area="" asp-page="/System/EnhancementRequests">Enhancement Requests</a>
                                    </li>
                                    @if (canManageSecurity && !DemoMode.IsEnabled)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/System/Settings") ? "active" : null)" asp-area="" asp-page="/System/Settings">Settings</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/System/Stats") ? "active" : null)" asp-area="" asp-page="/System/Stats">Stats</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/System/InboundEmail") ? "active" : null)" asp-area="" asp-page="/System/InboundEmail">Inbound Email</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/System/SignupRequests") ? "active" : null)" asp-area="" asp-page="/System/SignupRequests">Signup Requests</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/System/Onboarding") ? "active" : null)" asp-area="" asp-page="/System/Onboarding">Onboarding</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/System/Archive") ? "active" : null)" asp-area="" asp-page="/System/Archive">Archive</a>
                                        </li>
                                    }
                                    @if (DemoMode.IsEnabled)
                                    {
                                        <li>
                                            <a class="dropdown-item @(path.StartsWithSegments("/System/Demo") ? "active" : null)" asp-area="" asp-page="/System/Demo">Demo Mode</a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item @(path.StartsWithSegments("/System/Terms") ? "active" : null)" asp-area="" asp-page="/System/Terms">Terms</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(path.StartsWithSegments("/Help") ? "active" : null)" asp-area="" asp-page="/Help/Index">Help</a>
                        </li>
                    </ul>
                    @if (layoutCurrentUser is not null)
                    {
                        <div class="mf-nav-user">
                            <a class="btn btn-sm btn-outline-light mf-nav-profile-link" asp-area="" asp-page="/Account/Profile" title="My profile" aria-label="My profile">
                                <span aria-hidden="true">&#9881;</span>
                            </a>
                            <span class="navbar-text text-light">@signedInLabel</span>
                            @if (CurrentUserService.IsEntraLoginEnabled() && User?.Identity?.IsAuthenticated == true)
                            {
                                <form method="post" action="/Account/SignOut" class="m-0">
                                    <button class="btn btn-sm btn-outline-light" type="submit">Sign out</button>
                                </form>
                            }
                        </div>
                    }
                    else if (CurrentUserService.IsEntraLoginEnabled())
                    {
                        if (User?.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" action="/Account/SignOut" class="mf-nav-user">
                                <span class="navbar-text text-light">Signed in</span>
                                <button class="btn btn-sm btn-outline-light" type="submit">Sign out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" href="/Account/SignIn">Sign in</a>
                        }
                    }
                </div>
            </div>
        </nav>
        @if (DemoMode.IsEnabled)
        {
            <div class="mf-demo-banner">
                <div class="container d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                    <strong>@DemoMode.BannerMessage</strong>
                    <a class="btn btn-sm btn-warning" asp-area="" asp-page="/System/Demo">View demo controls</a>
                </div>
            </div>
        }
        @if (impersonationContext is not null)
        {
            <div class="mf-impersonation-banner">
                <div class="container d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                    <div>
                        <strong>Viewing as @impersonationContext.ImpersonatedUser.DisplayName</strong>
                        <span>Actual signed-in user: @impersonationContext.ActualUser.DisplayName</span>
                    </div>
                    <form method="post" asp-page="/Security/Impersonation" asp-page-handler="Stop">
                        <button class="btn btn-sm btn-warning" type="submit">Stop impersonating</button>
                    </form>
                </div>
            </div>
        }
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - @CMIForge.Services.ProductInfo.DisplayVersion · @currentPlan.Name plan
        </div>
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
