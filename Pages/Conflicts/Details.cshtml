@page "{id:guid}"
@model CMIForge.Pages.Conflicts.DetailsModel
@{
    ViewData["Title"] = Model.Search is null ? "Conflict Search" : $"Conflict Search {CMIForge.Services.RecordNumbers.ConflictSearch(Model.Search.SearchNumber)}";
}

@if (Model.Search is null)
{
    <div class="alert alert-warning">That conflict search could not be found.</div>
}
else
{
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Conflict Search <span>@CMIForge.Services.RecordNumbers.ConflictSearch(Model.Search.SearchNumber)</span> · @Model.Search.Status</p>
            <h1>@Model.Search.SearchName</h1>
            <p class="text-muted">Requested by @(Model.Search.RequestedByUser?.DisplayName ?? "System") on @UserDates.Format(Model.Search.CreatedAt, "f")</p>
        </div>
        <div class="mf-hero-actions">
            <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="mf-panel h-100">
                <h2>AI Assist Summary</h2>
                <p class="mt-3 mb-0">@Model.Search.AiSummary</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="mf-panel h-100">
                <h2>Context</h2>
                <dl class="row mt-3 mb-0">
                    <dt class="col-sm-5">Decision</dt>
                    <dd class="col-sm-7">@Model.Search.ReviewerDecision</dd>
                    <dt class="col-sm-5">Submission</dt>
                    <dd class="col-sm-7">
                        @if (Model.Search.FormSubmission is not null)
                        {
                            <a asp-page="/Submissions/Details" asp-route-id="@Model.Search.FormSubmission.Id">@CMIForge.Services.RecordNumbers.Submission(Model.Search.FormSubmission.SubmissionNumber)</a>
                        }
                    </dd>
                    <dt class="col-sm-5">Matter</dt>
                    <dd class="col-sm-7">
                        @if (Model.Search.Matter is not null)
                        {
                            <a asp-page="/Entities/Matters/Details" asp-route-id="@Model.Search.Matter.Id">@Model.Search.Matter.MatterNumber.ToString("D8")</a>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    @if (Model.IsArchived && Model.Archive is not null)
    {
        <div class="alert alert-info">
            This cleared search is loaded from the compressed archive payload. It remains searchable in the conflicts index and opens here for audit review.
            <span class="d-block mt-1">Archived @UserDates.Format(Model.Archive.ArchivedAt, "g") · @Model.Archive.ResultCount result(s)</span>
        </div>
    }

    @if (Model.CanReview)
    {
        <form method="post" class="mf-panel mb-3">
            <h2>Reviewer Decision</h2>
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label asp-for="Decision" class="form-label"></label>
                    <select asp-for="Decision" asp-items="Model.DecisionOptions" class="form-select"></select>
                </div>
                <div class="col-md-8">
                    <label asp-for="ReviewNotes" class="form-label"></label>
                    <input asp-for="ReviewNotes" class="form-control" placeholder="Clearance notes, waiver notes, or follow-up needed" />
                </div>
            </div>
            <button class="btn btn-primary mt-3" asp-page-handler="Review">Save decision</button>
        </form>
    }

    <div class="mf-panel mb-3">
        <h2>Search Terms</h2>
        <pre class="mf-pre mt-3">@Model.Search.SearchTerms</pre>
        @if (Model.CanRun)
        {
            <form method="post" class="mt-3" data-conflict-search-form data-conflict-search-progress-title="Re-running conflict search">
                <label asp-for="AdditionalSearchTerms" class="form-label">Additional terms before re-run</label>
                <textarea asp-for="AdditionalSearchTerms" class="form-control" rows="3" placeholder="Parent company, DBA, insurer, alternate spelling, opposing counsel"></textarea>
                <div class="form-text">These terms will be added to the existing search terms before CMIForge runs the search again.</div>
                <div class="mf-conflict-search-progress mt-3" data-conflict-search-progress hidden aria-live="polite" aria-atomic="true">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <strong data-conflict-search-progress-title>Re-running conflict search</strong>
                            <small class="d-block text-muted" data-conflict-search-progress-message>Preparing search terms...</small>
                        </div>
                        <span class="badge text-bg-light" data-conflict-search-progress-percent>0%</span>
                    </div>
                    <div class="progress mt-3" role="progressbar" aria-label="Conflict search progress" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" data-conflict-search-progress-bar style="width: 0%"></div>
                    </div>
                </div>
                <button class="btn btn-outline-primary mt-3" asp-page-handler="Rerun" data-conflict-search-submit>Re-run search</button>
            </form>
        }
    </div>

    <div class="mf-panel">
        <h2>Results</h2>
        @if (Model.Results.Count == 0)
        {
            <p class="text-muted mt-3 mb-0">No candidate hits were found.</p>
        }
        else
        {
            var clearanceFilterOptions = Model.Results
                .Select(x => x.ClearanceStatus)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => Array.IndexOf(CMIForge.Models.ConflictSearchDecisions.All, x) < 0 ? int.MaxValue : Array.IndexOf(CMIForge.Models.ConflictSearchDecisions.All, x))
                .ThenBy(x => x)
                .ToList();
            var roleFilterOptions = Model.Results
                .Select(x => RoleFilterLabel(x.PartyRole))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x.StartsWith("Prior", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
                .ThenBy(x => x)
                .ToList();
            var riskFilterOptions = Model.Results
                .Select(x => x.RiskLevel)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => RiskFilterOrder(x))
                .ThenBy(x => x)
                .ToList();
            @if (Model.CanReview)
            {
                <form method="post" id="bulk-clearance-form" asp-page-handler="BulkResultReview" asp-route-id="@Model.Search.Id" class="mf-conflict-bulk-panel mt-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label" for="bulkResultStatus">Selected rows</label>
                            <select id="bulkResultStatus" name="bulkResultStatus" class="form-select">
                                @foreach (var option in Model.ResultStatusOptions)
                                {
                                    <option value="@option" selected="@(option == CMIForge.Models.ConflictSearchDecisions.Clear)">@option</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" for="bulkResultNotes">Notes</label>
                            <input id="bulkResultNotes" name="bulkResultNotes" class="form-control" placeholder="Optional note for every selected result" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" type="submit" asp-page-handler="BulkResultReview">Apply</button>
                        </div>
                    </div>
                    <div class="row g-2 align-items-end mt-2">
                        <div class="col-md-3">
                            <label class="form-label" asp-for="EscalatedToUserId">Escalate to</label>
                            <select asp-for="EscalatedToUserId" asp-items="Model.UserOptions" class="form-select">
                                <option value="">Choose user</option>
                            </select>
                            <span asp-validation-for="EscalatedToUserId" class="text-danger"></span>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" asp-for="EscalationNotes">Escalation notes</label>
                            <input asp-for="EscalationNotes" class="form-control" placeholder="Why this result needs approval" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-outline-primary w-100" type="submit" asp-page-handler="BulkEscalate">Escalate selected</button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        <span data-conflict-selected-count>0 selected</span>. Select one or more result rows below, then apply a clearance decision or escalate them to another reviewer.
                    </small>
                </form>
            }
            <div class="mf-result-filters mt-3" data-conflict-result-filters>
                <div>
                    <label class="form-label" for="conflict-clearance-filter">Clearance</label>
                    <select id="conflict-clearance-filter" class="form-select form-select-sm" data-conflict-filter="clearance">
                        <option value="">All statuses</option>
                        @foreach (var option in clearanceFilterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="conflict-role-filter">Role / source</label>
                    <select id="conflict-role-filter" class="form-select form-select-sm" data-conflict-filter="role">
                        <option value="">All roles</option>
                        @foreach (var option in roleFilterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="conflict-risk-filter">Risk</label>
                    <select id="conflict-risk-filter" class="form-select form-select-sm" data-conflict-filter="risk">
                        <option value="">All risks</option>
                        @foreach (var option in riskFilterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>
                <div class="mf-result-filter-actions">
                    <span class="badge text-bg-light" data-conflict-filter-count>@Model.Results.Count result(s)</span>
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-conflict-filter-clear>Clear</button>
                </div>
            </div>
            <p class="text-muted mt-3 mb-0 d-none" data-conflict-filter-empty>No results match the selected filters.</p>
            <div class="table-responsive">
                <table class="table align-middle mf-conflict-results-table">
                    <thead>
                        <tr>
                            @if (Model.CanReview)
                            {
                                <th>
                                    <input class="form-check-input" type="checkbox" id="select-all-conflict-results" aria-label="Select all conflict results" />
                                </th>
                            }
                            <th>Match strength</th>
                            <th>Risk</th>
                            <th>Matched item</th>
                            <th>Role/context</th>
                            <th>Clearance</th>
                            <th>Why</th>
                            <th>AI assessment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model.Results.OrderByDescending(x => x.Score).ThenBy(x => x.MatchedName))
                        {
                            <tr data-conflict-result-row data-clearance="@result.ClearanceStatus" data-role="@RoleFilterLabel(result.PartyRole)" data-risk="@result.RiskLevel">
                                @if (Model.CanReview)
                                {
                                    <td>
                                        <input class="form-check-input" type="checkbox" name="selectedResultIds" value="@result.Id" form="bulk-clearance-form" aria-label="Select result @result.MatchedName" />
                                    </td>
                                }
                                <td><strong>@result.Score</strong></td>
                                <td><span class="badge @RiskClass(result.RiskLevel)">@result.RiskLevel</span></td>
                                <td>
                                    @if (result.PartyId.HasValue)
                                    {
                                        <a asp-page="/Entities/Parties/Details" asp-route-id="@result.PartyId">@(!string.IsNullOrWhiteSpace(result.PartyName) ? result.PartyName : result.MatchedName)</a>
                                        <small class="d-block text-muted">Matched: @result.MatchedName</small>
                                    }
                                    else
                                    {
                                        @result.MatchedName
                                    }
                                </td>
                                <td>
                                    <strong>@result.PartyRole</strong>
                                    @if (result.MatterId.HasValue)
                                    {
                                        <small class="d-block text-muted">
                                            Matter
                                            <a asp-page="/Entities/Matters/Details" asp-route-id="@result.MatterId">@(result.MatterNumber?.ToString("D8") ?? "Linked")</a>
                                            @result.MatterName
                                        </small>
                                    }
                                    @if (result.ClientId.HasValue)
                                    {
                                        <small class="d-block text-muted">
                                            Client
                                            <a asp-page="/Entities/Clients/Details" asp-route-id="@result.ClientId">@(result.ClientNumber?.ToString("D8") ?? "Linked")</a>
                                            @result.ClientName
                                        </small>
                                    }
                                </td>
                                <td style="min-width: 260px;">
                                    <span class="badge @DecisionClass(result.ClearanceStatus)">@result.ClearanceStatus</span>
                                    @if (result.ClearedAt.HasValue)
                                    {
                                        <small class="d-block text-muted">
                                            By @(string.IsNullOrWhiteSpace(result.ClearedByDisplayName) ? "System" : result.ClearedByDisplayName) on @UserDates.Format(result.ClearedAt.Value, "g")
                                        </small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(result.ClearanceNotes))
                                    {
                                        <small class="d-block mt-1">@result.ClearanceNotes</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(result.EscalatedToDisplayName))
                                    {
                                        <div class="border-top mt-2 pt-2">
                                            <span class="badge @(result.EscalationApprovedAt.HasValue ? "text-bg-success" : "text-bg-primary")">
                                                @(result.EscalationApprovedAt.HasValue ? "Escalation approved" : "Escalated")
                                            </span>
                                            <small class="d-block text-muted">
                                                To @result.EscalatedToDisplayName
                                                @if (!string.IsNullOrWhiteSpace(result.EscalatedByDisplayName))
                                                {
                                                    <span>by @result.EscalatedByDisplayName</span>
                                                }
                                                @if (result.EscalatedAt.HasValue)
                                                {
                                                    <span>on @UserDates.Format(result.EscalatedAt.Value, "g")</span>
                                                }
                                            </small>
                                            @if (!string.IsNullOrWhiteSpace(result.EscalationNotes))
                                            {
                                                <small class="d-block mt-1">@result.EscalationNotes</small>
                                            }
                                            @if (result.EscalationApprovedAt.HasValue)
                                            {
                                                <small class="d-block text-muted">
                                                    Approved by @(string.IsNullOrWhiteSpace(result.EscalationApprovedByDisplayName) ? "Assigned reviewer" : result.EscalationApprovedByDisplayName)
                                                    on @UserDates.Format(result.EscalationApprovedAt.Value, "g")
                                                </small>
                                                @if (!string.IsNullOrWhiteSpace(result.EscalationApprovalNotes))
                                                {
                                                    <small class="d-block mt-1">@result.EscalationApprovalNotes</small>
                                                }
                                            }
                                        </div>
                                    }
                                    @if (Model.CanReview)
                                    {
                                        var hasPendingEscalation = !string.IsNullOrWhiteSpace(result.EscalatedToDisplayName) && !result.EscalationApprovedAt.HasValue;
                                        <details class="mf-row-actions mt-2">
                                            <summary>@(hasPendingEscalation ? "Row actions / approve" : "Row actions")</summary>
                                            <div class="mf-row-action-grid mt-2">
                                                <form method="post" asp-page-handler="ResultReview" asp-route-id="@Model.Search.Id" asp-route-resultId="@result.Id">
                                                    <label class="form-label small text-muted mb-1" for="ResultStatus_@result.Id">Clearance</label>
                                                    <select name="resultStatus" id="ResultStatus_@result.Id" class="form-select form-select-sm mb-2" aria-label="Result clearance status">
                                                        @foreach (var option in Model.ResultStatusOptions)
                                                        {
                                                            if (option == result.ClearanceStatus)
                                                            {
                                                                <option value="@option" selected>@option</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@option">@option</option>
                                                            }
                                                        }
                                                    </select>
                                                    <textarea name="resultNotes" class="form-control form-control-sm" rows="2" placeholder="Clearance notes">@result.ClearanceNotes</textarea>
                                                    <button class="btn btn-sm btn-primary mt-2">Save row</button>
                                                </form>
                                                <form method="post" asp-page-handler="ResultEscalate" asp-route-id="@Model.Search.Id" asp-route-resultId="@result.Id">
                                                    <label class="form-label small text-muted mb-1" for="EscalatedToUserId_@result.Id">Escalate</label>
                                                    <select name="EscalatedToUserId" id="EscalatedToUserId_@result.Id" class="form-select form-select-sm mb-2" aria-label="Escalate result to user">
                                                        <option value="">Choose user...</option>
                                                        @foreach (var userOption in Model.UserOptions)
                                                        {
                                                            <option value="@userOption.Value">@userOption.Text</option>
                                                        }
                                                    </select>
                                                    <textarea name="EscalationNotes" id="EscalationNotes_@result.Id" class="form-control form-control-sm" rows="2" placeholder="Escalation notes"></textarea>
                                                    <button class="btn btn-sm btn-outline-primary mt-2">Escalate row</button>
                                                </form>
                                                @if (hasPendingEscalation)
                                                {
                                                    <form method="post" asp-page-handler="ApproveEscalation" asp-route-id="@Model.Search.Id" asp-route-resultId="@result.Id">
                                                        <label class="form-label small text-muted mb-1" for="EscalationApprovalNotes_@result.Id">Approval</label>
                                                        <textarea name="EscalationApprovalNotes" id="EscalationApprovalNotes_@result.Id" class="form-control form-control-sm" rows="2" placeholder="Approval notes"></textarea>
                                                        <button class="btn btn-sm btn-success mt-2">Approve escalation</button>
                                                    </form>
                                                }
                                            </div>
                                        </details>
                                    }
                                </td>
                                <td>
                                    <strong>@result.MatchType</strong>
                                    <small class="d-block text-muted">@result.Explanation</small>
                                </td>
                                <td>@result.AiAssessment</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <partial name="/Pages/Entities/_EntityAuditHistory.cshtml" model="Model.AuditHistory" />
}

@section Scripts {
    <script src="~/js/conflict-search-progress.js" asp-append-version="true"></script>
    <script>
        (() => {
            const selectAll = document.getElementById('select-all-conflict-results');
            const rows = Array.from(document.querySelectorAll('[data-conflict-result-row]'));
            const filters = Array.from(document.querySelectorAll('[data-conflict-filter]'));
            const clearFilters = document.querySelector('[data-conflict-filter-clear]');
            const count = document.querySelector('[data-conflict-filter-count]');
            const empty = document.querySelector('[data-conflict-filter-empty]');
            const selectedCount = document.querySelector('[data-conflict-selected-count]');

            if (rows.length === 0) {
                return;
            }

            const checkboxes = Array.from(document.querySelectorAll('input[name="selectedResultIds"][form="bulk-clearance-form"]'));
            const visibleRows = () => rows.filter((row) => !row.classList.contains('d-none'));
            const visibleCheckboxes = () => visibleRows()
                .map((row) => row.querySelector('input[name="selectedResultIds"][form="bulk-clearance-form"]'))
                .filter(Boolean);

            const updateSelectAllState = () => {
                if (!selectAll) {
                    return;
                }

                const visible = visibleCheckboxes();
                const checkedCount = visible.filter((checkbox) => checkbox.checked).length;
                const totalCheckedCount = checkboxes.filter((checkbox) => checkbox.checked).length;
                selectAll.checked = visible.length > 0 && checkedCount === visible.length;
                selectAll.indeterminate = checkedCount > 0 && checkedCount < visible.length;
                selectAll.disabled = visible.length === 0;

                if (selectedCount) {
                    selectedCount.textContent = `${totalCheckedCount} selected`;
                }
            };

            const applyFilters = () => {
                const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.conflictFilter, filter.value]));
                let visibleCount = 0;

                rows.forEach((row) => {
                    const isVisible = (!selected.clearance || row.dataset.clearance === selected.clearance) &&
                        (!selected.role || row.dataset.role === selected.role) &&
                        (!selected.risk || row.dataset.risk === selected.risk);

                    row.classList.toggle('d-none', !isVisible);
                    if (isVisible) {
                        visibleCount += 1;
                    } else {
                        const checkbox = row.querySelector('input[name="selectedResultIds"][form="bulk-clearance-form"]');
                        if (checkbox) {
                            checkbox.checked = false;
                        }
                    }
                });

                if (count) {
                    count.textContent = `${visibleCount} of ${rows.length} result(s)`;
                }

                if (empty) {
                    empty.classList.toggle('d-none', visibleCount !== 0);
                }

                updateSelectAllState();
            };

            if (selectAll) {
                selectAll.addEventListener('change', () => {
                    visibleCheckboxes().forEach((checkbox) => {
                        checkbox.checked = selectAll.checked;
                    });
                    updateSelectAllState();
                });

                checkboxes.forEach((checkbox) => checkbox.addEventListener('change', updateSelectAllState));
            }

            filters.forEach((filter) => filter.addEventListener('change', applyFilters));
            clearFilters?.addEventListener('click', () => {
                filters.forEach((filter) => {
                    filter.value = '';
                });
                applyFilters();
            });

            applyFilters();
        })();
    </script>
}

@functions {
    private static string RiskClass(string risk)
    {
        return risk switch
        {
            CMIForge.Models.ConflictRiskLevels.Critical => "text-bg-danger",
            CMIForge.Models.ConflictRiskLevels.High => "text-bg-warning",
            CMIForge.Models.ConflictRiskLevels.Medium => "text-bg-info",
            _ => "text-bg-secondary"
        };
    }

    private static string DecisionClass(string decision)
    {
        return decision switch
        {
            CMIForge.Models.ConflictSearchDecisions.Clear => "text-bg-success",
            CMIForge.Models.ConflictSearchDecisions.Conflict => "text-bg-danger",
            CMIForge.Models.ConflictSearchDecisions.PotentialConflict => "text-bg-warning",
            CMIForge.Models.ConflictSearchDecisions.NeedsInfo => "text-bg-info",
            _ => "text-bg-secondary"
        };
    }

    private static string RoleFilterLabel(string role)
    {
        if (role.StartsWith("Prior ", StringComparison.OrdinalIgnoreCase))
        {
            return "Prior search/history";
        }

        return string.IsNullOrWhiteSpace(role) ? "Unspecified" : role;
    }

    private static int RiskFilterOrder(string risk)
    {
        return risk switch
        {
            CMIForge.Models.ConflictRiskLevels.Critical => 0,
            CMIForge.Models.ConflictRiskLevels.High => 1,
            CMIForge.Models.ConflictRiskLevels.Medium => 2,
            CMIForge.Models.ConflictRiskLevels.Low => 3,
            _ => 4
        };
    }
}
