@page "{id:guid}"
@model MatterForge.Pages.Conflicts.DetailsModel
@{
    ViewData["Title"] = Model.Search is null ? "Conflict Search" : $"Conflict Search {MatterForge.Services.RecordNumbers.ConflictSearch(Model.Search.SearchNumber)}";
}

@if (Model.Search is null)
{
    <div class="alert alert-warning">That conflict search could not be found.</div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Conflict Search <span>@MatterForge.Services.RecordNumbers.ConflictSearch(Model.Search.SearchNumber)</span> · @Model.Search.Status</p>
            <h1>@Model.Search.SearchName</h1>
            <p class="text-muted">Requested by @(Model.Search.RequestedByUser?.DisplayName ?? "System") on @UserDates.Format(Model.Search.CreatedAt, "f")</p>
        </div>
        <div class="mf-hero-actions">
            <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="mf-panel h-100">
                <h2>AI Assist Summary</h2>
                <p class="mt-3 mb-0">@Model.Search.AiSummary</p>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="mf-panel h-100">
                <h2>Context</h2>
                <dl class="row mt-3 mb-0">
                    <dt class="col-sm-5">Decision</dt>
                    <dd class="col-sm-7">@Model.Search.ReviewerDecision</dd>
                    <dt class="col-sm-5">Submission</dt>
                    <dd class="col-sm-7">
                        @if (Model.Search.FormSubmission is not null)
                        {
                            <a asp-page="/Submissions/Details" asp-route-id="@Model.Search.FormSubmission.Id">@MatterForge.Services.RecordNumbers.Submission(Model.Search.FormSubmission.SubmissionNumber)</a>
                        }
                    </dd>
                    <dt class="col-sm-5">Matter</dt>
                    <dd class="col-sm-7">
                        @if (Model.Search.Matter is not null)
                        {
                            <a asp-page="/Entities/Matters/Details" asp-route-id="@Model.Search.Matter.Id">@Model.Search.Matter.MatterNumber.ToString("D8")</a>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    @if (Model.CanReview)
    {
        <form method="post" class="mf-panel mb-3">
            <h2>Reviewer Decision</h2>
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label asp-for="Decision" class="form-label"></label>
                    <select asp-for="Decision" asp-items="Model.DecisionOptions" class="form-select"></select>
                </div>
                <div class="col-md-8">
                    <label asp-for="ReviewNotes" class="form-label"></label>
                    <input asp-for="ReviewNotes" class="form-control" placeholder="Clearance notes, waiver notes, or follow-up needed" />
                </div>
            </div>
            <button class="btn btn-primary mt-3" asp-page-handler="Review">Save decision</button>
        </form>
    }

    <div class="mf-panel mb-3">
        <h2>Search Terms</h2>
        <pre class="mf-pre mt-3">@Model.Search.SearchTerms</pre>
        @if (Model.CanRun)
        {
            <form method="post" class="mt-3">
                <label asp-for="AdditionalSearchTerms" class="form-label">Additional terms before re-run</label>
                <textarea asp-for="AdditionalSearchTerms" class="form-control" rows="3" placeholder="Parent company, DBA, insurer, alternate spelling, opposing counsel"></textarea>
                <div class="form-text">These terms will be added to the existing search terms before CMIForge runs the search again.</div>
                <button class="btn btn-outline-primary mt-3" asp-page-handler="Rerun">Re-run search</button>
            </form>
        }
    </div>

    <div class="mf-panel">
        <h2>Results</h2>
        @if (Model.Search.Results.Count == 0)
        {
            <p class="text-muted mt-3 mb-0">No candidate hits were found.</p>
        }
        else
        {
            @if (Model.CanReview)
            {
                <form method="post" id="bulk-clearance-form" asp-page-handler="BulkResultReview" asp-route-id="@Model.Search.Id" class="border rounded p-3 mt-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label" for="bulkResultStatus">Selected rows</label>
                            <select id="bulkResultStatus" name="bulkResultStatus" class="form-select">
                                @foreach (var option in Model.ResultStatusOptions)
                                {
                                    <option value="@option" selected="@(option == MatterForge.Models.ConflictSearchDecisions.Clear)">@option</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" for="bulkResultNotes">Notes</label>
                            <input id="bulkResultNotes" name="bulkResultNotes" class="form-control" placeholder="Optional note for every selected result" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" type="submit">Apply</button>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">Select one or more result rows below, then apply the same clearance decision to all of them.</small>
                </form>
            }
            <div class="table-responsive mt-3">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            @if (Model.CanReview)
                            {
                                <th>Select</th>
                            }
                            <th>Score</th>
                            <th>Risk</th>
                            <th>Matched item</th>
                            <th>Role/context</th>
                            <th>Clearance</th>
                            <th>Why</th>
                            <th>AI assessment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model.Search.Results.OrderByDescending(x => x.Score).ThenBy(x => x.MatchedName))
                        {
                            <tr>
                                @if (Model.CanReview)
                                {
                                    <td>
                                        <input class="form-check-input" type="checkbox" name="selectedResultIds" value="@result.Id" form="bulk-clearance-form" aria-label="Select result @result.MatchedName" />
                                    </td>
                                }
                                <td><strong>@result.Score</strong></td>
                                <td><span class="badge @RiskClass(result.RiskLevel)">@result.RiskLevel</span></td>
                                <td>
                                    @if (result.Party is not null)
                                    {
                                        <a asp-page="/Entities/Parties/Details" asp-route-id="@result.Party.Id">@result.Party.Name</a>
                                        <small class="d-block text-muted">Matched: @result.MatchedName</small>
                                    }
                                    else
                                    {
                                        @result.MatchedName
                                    }
                                </td>
                                <td>
                                    <strong>@result.PartyRole</strong>
                                    @if (result.Matter is not null)
                                    {
                                        <small class="d-block text-muted">
                                            Matter
                                            <a asp-page="/Entities/Matters/Details" asp-route-id="@result.Matter.Id">@result.Matter.MatterNumber.ToString("D8")</a>
                                            @result.Matter.Name
                                        </small>
                                    }
                                    @if (result.Client is not null)
                                    {
                                        <small class="d-block text-muted">
                                            Client
                                            <a asp-page="/Entities/Clients/Details" asp-route-id="@result.Client.Id">@result.Client.ClientNumber.ToString("D8")</a>
                                            @result.Client.Name
                                        </small>
                                    }
                                </td>
                                <td style="min-width: 260px;">
                                    <span class="badge @DecisionClass(result.ClearanceStatus)">@result.ClearanceStatus</span>
                                    @if (result.ClearedAt.HasValue)
                                    {
                                        <small class="d-block text-muted">
                                            By @(result.ClearedByUser?.DisplayName ?? "System") on @UserDates.Format(result.ClearedAt.Value, "g")
                                        </small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(result.ClearanceNotes))
                                    {
                                        <small class="d-block mt-1">@result.ClearanceNotes</small>
                                    }
                                    @if (Model.CanReview)
                                    {
                                        <form method="post" class="mt-2" asp-page-handler="ResultReview" asp-route-id="@Model.Search.Id" asp-route-resultId="@result.Id">
                                            <select name="resultStatus" class="form-select form-select-sm mb-2" aria-label="Result clearance status">
                                                @foreach (var option in Model.ResultStatusOptions)
                                                {
                                                    if (option == result.ClearanceStatus)
                                                    {
                                                        <option value="@option" selected>@option</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@option">@option</option>
                                                    }
                                                }
                                            </select>
                                            <textarea name="resultNotes" class="form-control form-control-sm" rows="2" placeholder="Result-level clearance notes">@result.ClearanceNotes</textarea>
                                            <button class="btn btn-sm btn-primary mt-2">Save row</button>
                                        </form>
                                    }
                                </td>
                                <td>
                                    <strong>@result.MatchType</strong>
                                    <small class="d-block text-muted">@result.Explanation</small>
                                </td>
                                <td>@result.AiAssessment</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@functions {
    private static string RiskClass(string risk)
    {
        return risk switch
        {
            MatterForge.Models.ConflictRiskLevels.Critical => "text-bg-danger",
            MatterForge.Models.ConflictRiskLevels.High => "text-bg-warning",
            MatterForge.Models.ConflictRiskLevels.Medium => "text-bg-info",
            _ => "text-bg-secondary"
        };
    }

    private static string DecisionClass(string decision)
    {
        return decision switch
        {
            MatterForge.Models.ConflictSearchDecisions.Clear => "text-bg-success",
            MatterForge.Models.ConflictSearchDecisions.Conflict => "text-bg-danger",
            MatterForge.Models.ConflictSearchDecisions.PotentialConflict => "text-bg-warning",
            MatterForge.Models.ConflictSearchDecisions.NeedsInfo => "text-bg-info",
            _ => "text-bg-secondary"
        };
    }
}
