@page
@model MatterForge.Pages.Conflicts.CreateModel
@{
    ViewData["Title"] = "Run Conflict Search";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Conflicts</p>
        <h1>Run Conflict Search</h1>
        <p class="text-muted">Search terms are matched against party names, aliases, matter roles, and related parties.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
</div>

<form method="post" class="mf-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="SubmissionId" />

    @if (Model.SourceSubmission is not null)
    {
        <div class="alert alert-info">
            Source submission:
            <a asp-page="/Submissions/Details" asp-route-id="@Model.SourceSubmission.Id">@MatterForge.Services.RecordNumbers.Submission(Model.SourceSubmission.SubmissionNumber) - @Model.SourceSubmission.FormDefinition?.Name</a>
        </div>
    }

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Input.SearchName" class="form-label"></label>
            <input asp-for="Input.SearchName" class="form-control" />
            <span asp-validation-for="Input.SearchName" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Input.MatterId" class="form-label"></label>
            <select asp-for="Input.MatterId" asp-items="Model.MatterOptions" class="form-select">
                <option value="">No matter context</option>
            </select>
        </div>
        <div class="col-12">
            <label asp-for="Input.SearchTerms" class="form-label"></label>
            <textarea asp-for="Input.SearchTerms" class="form-control" rows="8" placeholder="One party/search term per line"></textarea>
            <span asp-validation-for="Input.SearchTerms" class="text-danger"></span>
            <small class="text-muted">CMIForge normalizes punctuation and corporate suffixes, checks aliases, then applies fuzzy scoring and relationship expansion.</small>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit">Run search</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
