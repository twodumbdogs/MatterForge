@page
@model CMIForge.Pages.Conflicts.IndexModel
@{
    ViewData["Title"] = "Conflicts";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Conflicts</p>
        <h1>Conflict Searches</h1>
        <p class="text-muted">Run party, alias, relationship, and matter-context searches before approval and conversion.</p>
    </div>
    @if (Model.CanRunSearches)
    {
        <a class="btn btn-primary" asp-page="./Create">New</a>
    }
</div>

<div class="mf-panel">
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-8 col-lg-6">
            <label asp-for="Query" class="form-label">Search conflicts</label>
            <input asp-for="Query" class="form-control" placeholder="Name, matter, client, clearance notes, result text" />
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-primary" type="submit">Search</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="col-auto">
                <a class="btn btn-outline-secondary" asp-page="./Index">Clear</a>
            </div>
        }
    </form>

    @if (Model.Searches.Count == 0)
    {
        <p class="text-muted mb-0">No conflict searches yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mf-compact-table">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Search</th>
                        <th>Status</th>
                        <th>Decision</th>
                        <th>Results</th>
                        <th>Requested by</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var search in Model.Searches)
                    {
                        <tr>
                            <td><a asp-page="./Details" asp-route-id="@search.Id"><code>@CMIForge.Services.RecordNumbers.ConflictSearch(search.SearchNumber)</code></a></td>
                            <td class="mf-truncate-cell">
                                <a class="mf-record-link" asp-page="./Details" asp-route-id="@search.Id">
                                    <strong>@search.SearchName</strong>
                                    @if (search.IsArchived)
                                    {
                                        <span class="badge text-bg-light ms-1">Archived</span>
                                    }
                                    @if (search.SubmissionNumber.HasValue)
                                    {
                                        <span class="mf-inline-context">Submission @CMIForge.Services.RecordNumbers.Submission(search.SubmissionNumber.Value) &middot; @search.FormName</span>
                                    }
                                    @if (search.MatterNumber.HasValue)
                                    {
                                        <span class="mf-inline-context">Matter @search.MatterNumber.Value.ToString("D8") &middot; @search.MatterName</span>
                                    }
                                </a>
                            </td>
                            <td><span class="badge text-bg-primary">@search.Status</span></td>
                            <td>@search.ReviewerDecision</td>
                            <td>
                                @search.ResultCount
                                @if (!string.IsNullOrWhiteSpace(search.HighestRiskLevel))
                                {
                                    <span class="badge @RiskClass(search.HighestRiskLevel) ms-1">@search.HighestRiskLevel</span>
                                }
                            </td>
                            <td>@search.RequestedBy</td>
                            <td>@UserDates.Format(search.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    private static string RiskClass(string risk)
    {
        return risk switch
        {
            CMIForge.Models.ConflictRiskLevels.Critical => "text-bg-danger",
            CMIForge.Models.ConflictRiskLevels.High => "text-bg-warning",
            CMIForge.Models.ConflictRiskLevels.Medium => "text-bg-info",
            _ => "text-bg-secondary"
        };
    }
}
