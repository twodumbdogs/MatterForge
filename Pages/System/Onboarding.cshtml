@page
@model MatterForge.Pages.System.OnboardingModel
@{
    ViewData["Title"] = "Customer Onboarding";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">System</p>
        <h1>Customer Onboarding</h1>
        <p class="text-muted">A working checklist for standing up a real customer workspace after provisioning.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/System/SignupRequests">Signup requests</a>
</div>

<section class="mf-panel">
    <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
        <div>
            <h2>Setup Progress</h2>
            <p class="text-muted mb-0">@Model.CompletedCount of @Model.Items.Count items complete.</p>
        </div>
        <div class="display-6">@Model.PercentComplete%</div>
    </div>
    <div class="progress mt-3" role="progressbar" aria-label="Onboarding progress" aria-valuenow="@Model.PercentComplete" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: @Model.PercentComplete%"></div>
    </div>
</section>

<section class="mf-panel mt-3">
    <h2>Checklist</h2>
    <div class="table-responsive mt-3">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Item</th>
                    <th>Why it matters</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <span class="badge @(item.IsComplete ? "text-bg-success" : "text-bg-warning")">@(item.IsComplete ? "Done" : "Open")</span>
                        </td>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.Description</td>
                        <td><a class="btn btn-sm btn-outline-primary" href="@item.Link">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
