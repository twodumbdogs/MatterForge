@page
@model CMIForge.Pages.System.EnhancementRequestsModel
@{
    ViewData["Title"] = "Enhancement Requests";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">System</p>
        <h1>Enhancement Requests</h1>
        <p class="text-muted">Submit product ideas, see the firm queue, and support the ideas you want most.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<section class="mf-panel mb-3">
    <h2>New Request</h2>
    <form method="post" asp-page-handler="Create" class="row g-3 mt-1">
        <div class="col-md-8">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" placeholder="Make conflict previews smarter" />
            <span asp-validation-for="Input.Title" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Area" class="form-label"></label>
            <select asp-for="Input.Area" class="form-select">
                @foreach (var area in Model.AreaOptions)
                {
                    <option value="@area">@area</option>
                }
            </select>
            <span asp-validation-for="Input.Area" class="text-danger"></span>
        </div>
        <div class="col-md-2">
            <label asp-for="Input.Priority" class="form-label"></label>
            <select asp-for="Input.Priority" class="form-select">
                @foreach (var priority in Model.PriorityOptions)
                {
                    <option value="@priority">@priority</option>
                }
            </select>
            <span asp-validation-for="Input.Priority" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="What should the product do, and where would you expect to use it?"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.BusinessValue" class="form-label"></label>
            <textarea asp-for="Input.BusinessValue" class="form-control" rows="2" placeholder="Optional: who benefits, how often, and what pain it removes."></textarea>
            <span asp-validation-for="Input.BusinessValue" class="text-danger"></span>
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit">Submit request</button>
        </div>
    </form>
</section>

<section class="mf-panel">
    <h2>@(Model.CanManageRequests ? "Firm Request Queue" : "Firm Requests")</h2>
    @if (Model.Requests.Count == 0)
    {
        <p class="text-muted mb-0">No enhancement requests yet.</p>
    }
    else
    {
        <div class="table-responsive mt-3">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Support</th>
                        <th>Request</th>
                        <th>Area</th>
                        <th>Priority</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        @if (Model.CanManageRequests)
                        {
                            <th>Internal notes</th>
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.Requests)
                    {
                        var voted = Model.CurrentUserVoted(request);
                        <tr>
                            <td class="text-nowrap">
                                <form method="post" asp-page-handler="Vote">
                                    <input type="hidden" name="id" value="@request.Id" />
                                    <button class="btn btn-sm @(voted ? "btn-primary" : "btn-outline-primary")" type="submit">
                                        @(voted ? "Supported" : "Support")
                                    </button>
                                </form>
                                <small class="d-block text-muted mt-1">@request.Votes.Count vote@(request.Votes.Count == 1 ? "" : "s")</small>
                            </td>
                            <td>
                                <strong>@request.Title</strong>
                                <small class="d-block text-muted">@request.Description</small>
                                @if (!string.IsNullOrWhiteSpace(request.BusinessValue))
                                {
                                    <small class="d-block mt-1">@request.BusinessValue</small>
                                }
                            </td>
                            <td>@request.Area</td>
                            <td>@request.Priority</td>
                            <td>
                                @UserDates.Format(request.CreatedAt)
                                <small class="d-block text-muted">
                                    @(string.IsNullOrWhiteSpace(request.SubmittedByDisplayName) ? request.SubmittedByEmail : request.SubmittedByDisplayName)
                                </small>
                            </td>
                            @if (Model.CanManageRequests)
                            {
                                <td colspan="3">
                                    <form method="post" asp-page-handler="Update" class="row g-2">
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <div class="col-md-3">
                                            <select class="form-select form-select-sm" name="status">
                                                @foreach (var status in Model.StatusOptions)
                                                {
                                                    <option value="@status" selected="@(request.Status == status)">@status</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-7">
                                            <textarea class="form-control form-control-sm" name="internalNotes" rows="2">@request.InternalNotes</textarea>
                                            @if (request.UpdatedByUser is not null)
                                            {
                                                <small class="text-muted">Last touched by @request.UpdatedByUser.DisplayName</small>
                                            }
                                        </div>
                                        <div class="col-md-2">
                                            <button class="btn btn-sm btn-primary w-100" type="submit">Save</button>
                                        </div>
                                    </form>
                                </td>
                            }
                            else
                            {
                                <td><span class="badge text-bg-light">@request.Status</span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
