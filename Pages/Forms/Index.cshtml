@page
@model CMIForge.Pages.Forms.IndexModel
@{
    ViewData["Title"] = "Forms";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Admin</p>
        <h1>Forms</h1>
    </div>
    <a class="btn btn-primary" asp-page="./Create">Create form</a>
</div>

<div class="mf-panel">
    @if (Model.Forms.Count == 0)
    {
        <p class="text-muted mb-0">No forms have been created yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Key</th>
                        <th>Versions</th>
                        <th>Workflow</th>
                        <th>Submissions</th>
                        <th>Client links</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var form in Model.Forms)
                    {
                        <tr>
                            <td>
                                <strong>@form.Name</strong>
                                <small class="d-block text-muted">@form.Description</small>
                            </td>
                            <td><code>@form.Key</code></td>
                            <td>@form.Versions.Count</td>
                            <td>
                                @{
                                    var latestVersion = form.Versions
                                        .Where(x => x.IsPublished)
                                        .OrderByDescending(x => x.VersionNumber)
                                        .FirstOrDefault();
                                }
                                @(latestVersion?.WorkflowDefinition?.Name ?? "None")
                            </td>
                            <td>@Model.SubmissionCounts.GetValueOrDefault(form.Id)</td>
                            <td>
                                @{
                                    var inviteCounts = Model.InviteCounts.GetValueOrDefault(form.Id);
                                }
                                <span class="badge text-bg-primary">@(inviteCounts?.Open ?? 0) open</span>
                                <span class="badge text-bg-success">@(inviteCounts?.Completed ?? 0) done</span>
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Options
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-page="./Edit" asp-route-id="@form.Id">Edit</a></li>
                                        <li>
                                            <form method="post" asp-page-handler="Copy" asp-route-id="@form.Id">
                                                <button class="dropdown-item" type="submit">Copy</button>
                                            </form>
                                        </li>
                                        @if (Model.CanSubmitForms)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><a class="dropdown-item" asp-page="./Submit" asp-route-id="@form.Id">Fill</a></li>
                                            <li><a class="dropdown-item" asp-page="./Send" asp-route-id="@form.Id">Send</a></li>
                                        }
                                        @if (Model.CanManageFormWorkflowDefinitions)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@form.Id" onsubmit="return confirm('Retire this form? Existing submissions stay available, but the form will no longer be available for new submissions and open client links will be revoked.');">
                                                    <button class="dropdown-item text-danger" type="submit">Delete</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
