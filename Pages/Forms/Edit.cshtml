@page "{id:guid}"
@model CMIForge.Pages.Forms.EditModel
@{
    ViewData["Title"] = "Edit Form";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Definition builder</p>
        <h1>Edit Form</h1>
        <p class="text-muted">Saving changes publishes the next version. Existing submissions keep their original version.</p>
    </div>
</div>

<form method="post" class="mf-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Key" class="form-label"></label>
            <input asp-for="Input.Key" class="form-control" />
            <span asp-validation-for="Input.Key" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>
        </div>
        @if (Model.CanAttachWorkflow)
        {
            <div class="col-md-6">
                <label asp-for="Input.WorkflowDefinitionId" class="form-label"></label>
                <select asp-for="Input.WorkflowDefinitionId" asp-items="Model.WorkflowOptions" class="form-select">
                    <option value="">No workflow</option>
                </select>
                <span asp-validation-for="Input.WorkflowDefinitionId" class="text-danger"></span>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0">
                    Workflow attachment is available on plans that include workflow. Publishing this version will leave workflow automation unattached.
                    <a asp-page="/Billing/Index" asp-route-locked="@CMIForge.Services.ProductFeatureKeys.Workflow">View plans</a>
                </div>
            </div>
        }
    </div>

    <hr />

    <div class="mf-field-builder" data-form-designer data-max-fields="@Model.MaxFieldCount">
        <div class="mf-field-toolbar">
            <div>
                <h2 class="h5">Fields</h2>
                <p class="text-muted mb-0">Current published version: v@Model.CurrentVersionNumber. Drag fields to change their order.</p>
            </div>
            <div class="mf-field-toolbar-actions">
                <span class="badge text-bg-light" data-field-count></span>
                <button class="btn btn-outline-primary btn-sm" type="button" data-add-field>Add field</button>
            </div>
        </div>

        <div class="table-responsive mf-designer-table">
            <table class="table align-middle mf-designer-field-table">
                <colgroup>
                    <col class="mf-field-col-order" />
                    <col class="mf-field-col-section" />
                    <col class="mf-field-col-label" />
                    <col class="mf-field-col-key" />
                    <col class="mf-field-col-type" />
                    <col class="mf-field-col-required" />
                    <col class="mf-field-col-options" />
                    <col class="mf-field-col-condition" />
                    <col class="mf-field-col-step" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Section</th>
                        <th>Label</th>
                        <th>Key</th>
                        <th>Type</th>
                        <th>Required</th>
                        <th>Options</th>
                        <th>Show if</th>
                        <th>Editable step</th>
                    </tr>
                </thead>
                <tbody data-field-list>
                    @for (var i = 0; i < Model.Input.Fields.Count; i++)
                    {
                        <tr class="mf-field-row">
                            <td class="mf-field-order">
                                <span class="mf-drag-handle" draggable="true" data-drag-handle aria-label="Drag field to reorder" title="Drag field to reorder">
                                    <span class="mf-grip-icon" aria-hidden="true"></span>
                                </span>
                                <button class="btn btn-outline-danger btn-sm" type="button" data-remove-field>Remove</button>
                            </td>
                            <td>
                                <input class="form-control" asp-for="Input.Fields[i].Section" placeholder="Client" data-field-section />
                            </td>
                            <td>
                                <input class="form-control" asp-for="Input.Fields[i].Label" data-field-label />
                                <span asp-validation-for="Input.Fields[i].Label" class="text-danger"></span>
                            </td>
                            <td>
                                <input class="form-control" asp-for="Input.Fields[i].Key" data-field-key />
                                <span asp-validation-for="Input.Fields[i].Key" class="text-danger"></span>
                            </td>
                            <td>
                                <select class="form-select" asp-for="Input.Fields[i].Type" asp-items="Model.FieldTypeOptions"></select>
                            </td>
                            <td class="text-center"><input class="form-check-input" asp-for="Input.Fields[i].Required" /></td>
                            <td>
                                <input class="form-control" asp-for="Input.Fields[i].Options" placeholder="Corporate, Litigation, Real Estate" />
                                <span asp-validation-for="Input.Fields[i].Options" class="text-danger"></span>
                            </td>
                            <td>
                                <div class="mf-condition-pair">
                                    <input class="form-control" asp-for="Input.Fields[i].VisibleWhenFieldKey" placeholder="Field key" />
                                    <input class="form-control" asp-for="Input.Fields[i].VisibleWhenValue" placeholder="Value" />
                                </div>
                            </td>
                            <td>
                                <input class="form-control" asp-for="Input.Fields[i].EditableStepName" placeholder="Review" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <template data-field-template>
            <tr class="mf-field-row">
                <td class="mf-field-order">
                    <span class="mf-drag-handle" draggable="true" data-drag-handle aria-label="Drag field to reorder" title="Drag field to reorder">
                        <span class="mf-grip-icon" aria-hidden="true"></span>
                    </span>
                    <button class="btn btn-outline-danger btn-sm" type="button" data-remove-field>Remove</button>
                </td>
                <td><input class="form-control" name="Input.Fields[__index__].Section" placeholder="General" data-field-section /></td>
                <td><input class="form-control" name="Input.Fields[__index__].Label" data-field-label /></td>
                <td><input class="form-control" name="Input.Fields[__index__].Key" data-field-key /></td>
                <td>
                    <select class="form-select" name="Input.Fields[__index__].Type">
                        @foreach (var type in Enum.GetValues<CMIForge.Services.FieldType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </td>
                <td class="text-center">
                    <input name="Input.Fields[__index__].Required" type="hidden" value="false" />
                    <input class="form-check-input" name="Input.Fields[__index__].Required" type="checkbox" value="true" />
                </td>
                <td><input class="form-control" name="Input.Fields[__index__].Options" placeholder="Corporate, Litigation, Real Estate" /></td>
                <td>
                    <div class="mf-condition-pair">
                        <input class="form-control" name="Input.Fields[__index__].VisibleWhenFieldKey" placeholder="Field key" />
                        <input class="form-control" name="Input.Fields[__index__].VisibleWhenValue" placeholder="Value" />
                    </div>
                </td>
                <td><input class="form-control" name="Input.Fields[__index__].EditableStepName" placeholder="Review" /></td>
            </tr>
        </template>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Publish new version</button>
        <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/form-designer.js" asp-append-version="true"></script>
}
