@page "{id:guid}"
@model MatterForge.Pages.Forms.SubmitModel
@{
    ViewData["Title"] = Model.Form?.Name ?? "Submit Form";
}

@if (Model.Form is null || Model.Schema is null)
{
    <div class="alert alert-warning">That form could not be found.</div>
}
else
{
    <div class="mf-page-heading">
        <div>
            <p class="mf-eyebrow">Form v@Model.VersionNumber</p>
            <h1>@Model.Form.Name</h1>
            <p class="text-muted">@Model.Form.Description</p>
        </div>
    </div>

    <form method="post" class="mf-panel">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="SubmitterUserId" class="form-label"></label>
            <select asp-for="SubmitterUserId" asp-items="Model.SubmitterOptions" class="form-select">
                <option value="">Choose a user...</option>
            </select>
            <span asp-validation-for="SubmitterUserId" class="text-danger"></span>
        </div>

        @foreach (var field in Model.Schema.Fields)
        {
            <div class="mb-3">
                <label class="form-label" for="@field.Key">@field.Label@if (field.Required)
                    {<span class="text-danger"> *</span>}</label>
                @switch (field.Type)
                {
                    case MatterForge.Services.FieldType.TextArea:
                        <textarea class="form-control" id="@field.Key" name="Fields[@field.Key]" rows="4">@Model.PostedValues.GetValueOrDefault(field.Key)</textarea>
                        break;
                    case MatterForge.Services.FieldType.Client:
                        <input class="form-control" id="@field.Key" name="Fields[@field.Key]" list="client-options-@field.Key" value="@Model.PostedValues.GetValueOrDefault(field.Key)" placeholder="Pick an existing client or type a new name" />
                        <datalist id="client-options-@field.Key">
                            @foreach (var client in Model.ClientSuggestions)
                            {
                                <option value="@client.Name">@client.DisplayLabel</option>
                            }
                        </datalist>
                        <small class="text-muted">Choose an existing client name or enter a brand-new one.</small>
                        break;
                    case MatterForge.Services.FieldType.Select:
                        <select class="form-select" id="@field.Key" name="Fields[@field.Key]">
                            <option value="">Choose...</option>
                            @foreach (var option in field.Options)
                            {
                                <option value="@option" selected="@(Model.PostedValues.GetValueOrDefault(field.Key) == option)">@option</option>
                            }
                        </select>
                        break;
                    case MatterForge.Services.FieldType.Checkbox:
                        <div class="form-check">
                            <input class="form-check-input" id="@field.Key" name="Fields[@field.Key]" type="checkbox" value="true" checked="@(Model.PostedValues.GetValueOrDefault(field.Key) == "true")" />
                            <label class="form-check-label" for="@field.Key">Yes</label>
                        </div>
                        break;
                    case MatterForge.Services.FieldType.Date:
                        <input class="form-control" id="@field.Key" name="Fields[@field.Key]" type="date" value="@Model.PostedValues.GetValueOrDefault(field.Key)" />
                        break;
                    case MatterForge.Services.FieldType.Currency:
                    case MatterForge.Services.FieldType.Number:
                        <input class="form-control" id="@field.Key" name="Fields[@field.Key]" type="number" step="0.01" value="@Model.PostedValues.GetValueOrDefault(field.Key)" />
                        break;
                    default:
                        <input class="form-control" id="@field.Key" name="Fields[@field.Key]" value="@Model.PostedValues.GetValueOrDefault(field.Key)" />
                        break;
                }
            </div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Submit intake</button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
