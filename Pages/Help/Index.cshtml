@page
@{
    ViewData["Title"] = "Help";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">CMIForge Help</p>
        <h1>How CMIForge Works</h1>
        <p class="text-muted">A practical guide to the current build: intake forms, workflows, entities, conflicts, imports, security, and what is still intentionally in progress.</p>
    </div>
</div>

<section class="mf-help-grid">
    <aside class="mf-panel mf-help-toc">
        <h2>Contents</h2>
        <nav class="nav flex-column mt-3">
            <a class="nav-link" href="#big-picture">Big Picture</a>
            <a class="nav-link" href="#forms">Forms</a>
            <a class="nav-link" href="#submissions">Submissions</a>
            <a class="nav-link" href="#workflows">Workflows</a>
            <a class="nav-link" href="#entities">Entities</a>
            <a class="nav-link" href="#conflicts">Conflicts</a>
            <a class="nav-link" href="#imports">Imports</a>
            <a class="nav-link" href="#security">Security</a>
