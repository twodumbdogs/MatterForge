@page
@model CMIForge.Pages.Security.ImpersonationModel
@{
    ViewData["Title"] = "User Impersonation";
}

<div class="mf-page-heading">
    <div>
        <p class="mf-eyebrow">Security</p>
        <h1>User Impersonation</h1>
        <p class="text-muted">Temporarily view CMIForge as another active user for support, routing, and approval testing.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Index">Back to Security</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<div class="row g-3">
    <div class="col-lg-5">
        <section class="mf-panel h-100">
            <h2>Current Mode</h2>
            @if (Model.ActiveImpersonation is null)
            {
                <p class="text-muted mb-3">You are using CMIForge as yourself.</p>
                @if (Model.ActualUser is not null)
                {
                    <div class="mf-identity-card">
                        <strong>@Model.ActualUser.DisplayName</strong>
                        <span>@Model.ActualUser.Email</span>
                        <code>@Model.ActualUser.SystemId.ToString("D8")</code>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-3">Permission checks, queues, dashboards, and routing now behave as the selected user.</p>
                <div class="mf-identity-stack">
                    <div class="mf-identity-card">
                        <small>Actual signed-in user</small>
                        <strong>@Model.ActiveImpersonation.ActualUser.DisplayName</strong>
                        <span>@Model.ActiveImpersonation.ActualUser.Email</span>
                        <code>@Model.ActiveImpersonation.ActualUser.SystemId.ToString("D8")</code>
                    </div>
                    <div class="mf-identity-card mf-identity-card-active">
                        <small>Viewing as</small>
                        <strong>@Model.ActiveImpersonation.ImpersonatedUser.DisplayName</strong>
                        <span>@Model.ActiveImpersonation.ImpersonatedUser.Email</span>
                        <code>@Model.ActiveImpersonation.ImpersonatedUser.SystemId.ToString("D8")</code>
                    </div>
                </div>
                <form method="post" asp-page-handler="Stop" class="mt-3">
                    <button class="btn btn-warning" type="submit">Stop impersonating</button>
                </form>
            }
        </section>
    </div>
    <div class="col-lg-7">
        <form method="post" asp-page-handler="Start" class="mf-panel h-100">
            <h2>Start Impersonation</h2>
            <p class="text-muted">Choose an active user. Every start and stop is written to the audit log.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="TargetUserId" class="form-label">User</label>
                <select asp-for="TargetUserId" class="form-select">
                    <option value="">Choose user...</option>
                    @foreach (var user in Model.UserOptions)
                    {
                        <option value="@user.Id">
                            @user.DisplayName (@user.SystemId.ToString("D8")) - @user.Email
                        </option>
                    }
                </select>
                <span asp-validation-for="TargetUserId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Testing partner approval routing, support troubleshooting, etc."></textarea>
            </div>
            <button class="btn btn-primary" type="submit">View as selected user</button>
        </form>
    </div>
</div>

<section class="mf-panel mt-3">
    <h2>What This Does</h2>
    <ul class="mb-0">
        <li>The app uses the selected user for permissions, dashboards, queues, approvals, and routing checks.</li>
        <li>The banner stays visible while impersonation is active.</li>
        <li>Audit entries keep the real actor as the signed-in user and include the effective impersonated user in the details.</li>
        <li>Signing out or stopping impersonation returns the browser session to the actual user.</li>
    </ul>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
